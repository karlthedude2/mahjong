@using Mahjong.Web.Services
@using Microsoft.Extensions.Options
@inject IOptions<AdsOptions> Ads

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Mahjong.Web.styles.css"]" />
    <ImportMap />
    @* Apply the saved background before the page paints (the game page keeps it up to date). *@
    <script>
        try {
            var bg = localStorage.getItem("mahjong.backgroundUrl");
            if (bg && /^backgrounds\/[a-z0-9-]+\.(svg|jpg|png|webp)$/.test(bg)) {
                document.documentElement.style.setProperty("--page-background", 'url("' + bg + '")');
            }
        } catch (e) { }
    </script>
    <link rel="icon" type="image/png" href="favicon.png" />
    @if (!string.IsNullOrEmpty(Ads.Value.ClientId))
    {
        <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=@Ads.Value.ClientId" crossorigin="anonymous"></script>
    }
    <HeadOutlet />
</head>

<body>
    <Routes />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["Components/Account/Shared/PasskeySubmit.razor.js"]" type="module"></script>
</body>

</html>
