@using Mahjong.Web.Services
@using Microsoft.Extensions.Options
@inject IOptions<AdsOptions> Ads
@inject IOptions<AnalyticsOptions> Analytics

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Mahjong.Web.styles.css"]" />
    <ImportMap />
    @* Apply the saved background and sound setting before the page paints. *@
    <script>
        window.mahjongApplySettings = function () {
            try {
                var root = document.documentElement;
                var bg = localStorage.getItem("mahjong.backgroundUrl");
                if (bg && /^backgrounds\/[a-z0-9-]+\.(svg|jpg|png|webp)$/.test(bg)) {
                    root.style.setProperty("--page-background", 'url("' + bg + '")');
                }
                var muted = localStorage.getItem("mahjong.sound") === "off";
                root.dataset.sound = muted ? "off" : "on";
                document.querySelectorAll(".sound-toggle").forEach(function (button) {
                    var label = muted ? "Turn sound on" : "Mute sound";
                    button.setAttribute("aria-label", label);
                    button.setAttribute("data-tip", label);
                    button.setAttribute("aria-pressed", muted ? "true" : "false");
                });
            } catch (e) { }
        };
        window.mahjongApplySettings();
    </script>
    <link rel="icon" href="favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" href="favicon.png" sizes="96x96" />
    @if (!string.IsNullOrEmpty(Ads.Value.ClientId))
    {
        <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=@Ads.Value.ClientId" crossorigin="anonymous"></script>
    }
    <HeadOutlet />
</head>

<body>
    <Routes />
    @if (!string.IsNullOrEmpty(Analytics.Value.CloudflareToken))
    {
        @* Cloudflare Web Analytics: cookie-free visit counts (see the privacy policy). *@
        <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon="@($"{{\"token\": \"{Analytics.Value.CloudflareToken}\"}}")"></script>
    }
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script>
        // The speaker button in the header: flips the saved sound setting.
        document.addEventListener("click", function (e) {
            if (!e.target.closest || !e.target.closest(".sound-toggle")) {
                return;
            }
            try {
                var muted = localStorage.getItem("mahjong.sound") === "off";
                localStorage.setItem("mahjong.sound", muted ? "on" : "off");
            } catch (err) { }
            window.mahjongApplySettings();
        });
        // Page changes inside the site redraw the header, so reapply the settings afterwards.
        document.addEventListener("DOMContentLoaded", window.mahjongApplySettings);
        if (window.Blazor) {
            Blazor.addEventListener("enhancedload", window.mahjongApplySettings);
        }
    </script>
    <script src="@Assets["Components/Account/Shared/PasskeySubmit.razor.js"]" type="module"></script>
</body>

</html>
