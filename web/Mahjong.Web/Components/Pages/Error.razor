@page "/Error"
@using System.Diagnostics

<PageTitle>@L["Something went wrong"] - Mahjong Haus</PageTitle>

<h1>@L["Something went wrong"]</h1>
<p>@L.Html("Sorry, something went wrong on our side. Please try again in a moment, or <a href=\"\">go back to the game</a>.")</p>

@if (ShowRequestId)
{
    <p class="text-muted small">@L["If you contact us about this, please mention this code:"] <code>@RequestId</code></p>
}

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
