@page "/leaderboards"
@using Mahjong.Core
@using Mahjong.Web.Client.Api
@using Mahjong.Web.Services
@inject GameService Games

<PageTitle>Leaderboards</PageTitle>

<h1>Leaderboards</h1>
<p>
    The top @GameService.LeaderboardSize verified scores for each layout. <a href="Account/Login">Sign in</a> and play to get on the board.
    Think you can do better on someone's deal? <strong>Play this deal</strong> deals you the exact same tiles. Replays are ranked on
    that deal's own list, so the original first-play score always stays here. Scores marked <strong>Random deal</strong>
    were won on a randomly dealt board, which isn't guaranteed to be clearable.
</p>

<ul class="nav nav-pills mb-3">
    <li class="nav-item">
        <a class="nav-link @(game == GameKind.Solitaire ? "active" : null)" href="leaderboards?layout=@Uri.EscapeDataString(DefaultLayoutName)">Mahjong Solitaire</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(game == GameKind.Connect ? "active" : null)" href="leaderboards?layout=@Uri.EscapeDataString(LayoutCatalog.Connect[0].Name)">Connect (Shisen-Sho)</a>
    </li>
</ul>

<form method="get" class="d-flex gap-2 align-items-center mb-3">
    <label for="layout" class="form-label mb-0">@(game == GameKind.Connect ? "Board" : "Layout")</label>
    <select id="layout" name="layout" class="form-select w-auto" onchange="this.form.submit()">
        @foreach (var l in Choices)
        {
            <option value="@l.Name" selected="@(l.Name == selected)">@l.Name</option>
        }
    </select>
    <noscript><button type="submit" class="btn btn-primary">Show</button></noscript>
</form>

@if (entries.Count == 0)
{
    <p>No scores on @selected yet. Be the first!</p>
}
else
{
    <table class="table table-sm">
        <thead>
            <tr><th scope="col">#</th><th scope="col">Player</th><th scope="col" class="text-end">Score</th><th scope="col" class="text-end" title="How long the game took (pauses not counted)">Time</th><th scope="col" class="text-end">Date</th><th scope="col" class="text-end" title="Play the same deal and try to beat it. Replays are ranked on their own list.">Replay</th></tr>
        </thead>
        <tbody>
            @foreach (var entry in entries)
            {
                <tr>
                    <td>@entry.Rank</td>
                    <td>
                        @entry.DisplayName
                        @if (entry.RandomDeal)
                        {
                            <span class="badge bg-secondary ms-1" title="Won on a random deal, which isn't guaranteed to be clearable">Random deal</span>
                        }
                    </td>
                    <td class="text-end">@entry.Score.ToString("N0")</td>
                    <td class="text-end">@entry.TimeText</td>
                    <td class="text-end">@entry.AchievedUtc.ToString("d MMM yyyy")</td>
                    <td class="text-end text-nowrap">
                        <a href="?replay=@entry.GameId" title="Play this exact deal">Play this deal</a>
                        &middot;
                        <a href="replays/@entry.GameId" title="Best replay scores on this deal">Replays (@entry.ReplayCount)</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private const string DefaultLayoutName = "Twin Peaks";

    private string selected = DefaultLayoutName;
    private GameKind game;
    private IReadOnlyList<LeaderboardEntry> entries = [];

    // The layouts (or Connect boards) of the game being shown.
    private IEnumerable<LayoutDefinition> Choices => game == GameKind.Connect ? LayoutCatalog.Connect : LayoutCatalog.Visible;

    [SupplyParameterFromQuery]
    private string? Layout { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var layout = LayoutCatalog.Visible.Concat(LayoutCatalog.Connect).FirstOrDefault(l => l.Name == Layout)
            ?? LayoutCatalog.Find(DefaultLayoutName)!;
        selected = layout.Name;
        game = layout.Kind;
        entries = await Games.GetLeaderboardAsync(selected);
    }
}
