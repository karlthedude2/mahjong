@page "/replays/{GameId:guid}"
@using Mahjong.Web.Client.Api
@using Mahjong.Web.Client.Components
@using Mahjong.Web.Services
@inject GameService Games

<PageTitle>@(info == null ? L["Replays"] : L["{0}'s {1} deal", info.OriginalPlayer, L.LayoutName(info.Layout)]) - Mahjong Haus</PageTitle>

<div class="dark-page">
    @if (info == null)
    {
        <h1>@L["Replays"]</h1>
        <p class="status">@L.Html("This deal couldn't be found. It may never have been on a leaderboard. <a href=\"leaderboards\">Back to the leaderboards</a>")</p>
    }
    else
    {
        <div>
            <a class="back-link" href="leaderboards?layout=@Uri.EscapeDataString(info.Layout)">&larr; @L["Back to leaderboards"]</a>
            <h1>
                @L["{0}'s {1} deal", info.OriginalPlayer, L.LayoutName(info.Layout)]
                @if (info.RandomDeal)
                {
                    <span class="title-tag">@L["Random deal"]</span>
                }
            </h1>
        </div>
        <ReplayDetails Info="info" />
    }
</div>

@code {
    private ReplayInfo? info;

    [Parameter]
    public Guid GameId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        info = await Games.GetReplayInfoAsync(GameId);
    }
}
