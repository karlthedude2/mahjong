@page "/stats"
@using System.Security.Claims
@using Mahjong.Core
@using Mahjong.Web.Client.Components
@using Mahjong.Web.Data
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@attribute [Authorize]
@inject ApplicationDbContext Db

<PageTitle>@L["My stats"] - Mahjong Haus</PageTitle>

<div class="dark-page stats-page">
    <div class="page-head">
        @if (user != null)
        {
            <AvatarImage Id="@user.Avatar" Size="44" />
        }
        <div class="who">
            <h1>@L["My stats"]</h1>
            @if (user != null)
            {
                <span>@user.DisplayName</span>
            }
        </div>
    </div>

    @if (user != null)
    {
        <div class="stat-tiles">
            <div><span>@L["Played"]</span><strong>@user.GamesPlayed</strong></div>
            <div><span>@L["Won"]</span><strong>@user.GamesWon</strong></div>
            <div><span>@L["Win rate"]</span><strong>@(user.GamesPlayed == 0 ? "-" : $"{100.0 * user.GamesWon / user.GamesPlayed:0}%")</strong></div>
        </div>

        <h2>@L["Best scores"]</h2>
        @if (bests.Count == 0)
        {
            <p class="status">@L["Win a game to set your first best score."]</p>
        }
        else
        {
            @* Each best links to that layout's leaderboard. *@
            <ol class="bests">
                @foreach (var best in bests)
                {
                    <li>
                        <a href="leaderboards?layout=@Uri.EscapeDataString(best.Layout)">
                            <span class="what">
                                <span class="layout">@L.LayoutName(best.Layout)</span>
                                <span class="sub">@GameName(best.Layout) &middot; @(best.Wins == 1 ? L["1 win"] : L["{0} wins", best.Wins])</span>
                            </span>
                            <span class="best">@best.Score.ToString("N0")</span>
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
                        </a>
                    </li>
                }
            </ol>
        }
    }
</div>

@code {
    private ApplicationUser? user;
    private List<Best> bests = [];

    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var userId = (await AuthState).User.FindFirstValue(ClaimTypes.NameIdentifier);
        user = await Db.Users.FindAsync(userId);

        var rows = await Db.Games
            .Where(g => g.UserId == userId && g.Status == GameOutcome.Won)
            .GroupBy(g => g.LayoutName)
            .Select(g => new { Layout = g.Key, Score = g.Max(x => x.Score) ?? 0, Wins = g.Count() })
            .OrderByDescending(b => b.Score)
            .ToListAsync();
        bests = rows.Select(r => new Best(r.Layout, r.Score, r.Wins)).ToList();
    }

    private string GameName(string layout) => (LayoutCatalog.Find(layout)?.Kind) switch
    {
        GameKind.Connect => L["Connect"],
        GameKind.Cube => L["Cube"],
        _ => L["Solitaire"],
    };

    private sealed record Best(string Layout, int Score, int Wins);
}
