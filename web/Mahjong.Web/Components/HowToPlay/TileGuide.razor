@*
    Every kind of tile in the set, in the Classic tiles, with what it's called and what it scores
    (see Mahjong.Core's TileSet: suits 10, dragons and the peacock 20, winds, flowers and seasons 40).
*@
<ul class="tile-guide">
    @foreach (var group in Groups)
    {
        <li>
            <strong>@(Strings.IsSpanish ? group.Spanish : group.English)</strong>
            <span class="tiles">
                @foreach (var face in group.Faces)
                {
                    <img src="tilesets/classic/@(face).png" alt="" width="66" height="86" loading="lazy" />
                }
            </span>
            <span class="points">@(Strings.IsSpanish ? $"{group.Points} puntos por ficha" : $"{group.Points} points a tile")</span>
        </li>
    }
</ul>

@code {
    private sealed record Group(string English, string Spanish, int Points, string[] Faces);

    private static readonly Group[] Groups =
    [
        new("Bamboo, 2 to 9", "Bambú, del 2 al 9", 10, Enumerable.Range(2, 8).Select(n => n + "bams").ToArray()),
        new("Dots, 1 to 9", "Círculos, del 1 al 9", 10, Enumerable.Range(1, 9).Select(n => n + "dots").ToArray()),
        new("Characters, 1 to 9", "Caracteres, del 1 al 9", 10, Enumerable.Range(1, 9).Select(n => n + "crack").ToArray()),
        new("Dragons and the peacock", "Dragones y el pavo real", 20, ["Cdragon", "Fdragon", "Bdragon", "peacock"]),
        new("Winds", "Vientos", 40, ["East", "South", "West", "North"]),
        new("Flowers", "Flores", 40, ["1flower", "2flower", "3flower", "4flower"]),
        new("Seasons", "Estaciones", 40, ["1wizard", "2wizard", "3wizard", "4wizard"]),
    ];
}
