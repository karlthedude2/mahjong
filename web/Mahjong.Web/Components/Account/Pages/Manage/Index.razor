@page "/Account/Manage"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using Mahjong.Web.Data
@using Mahjong.Web.Client.Game
@using Mahjong.Web.Client.Components

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>@L["Profile"]</PageTitle>

<h3>@L["Profile"]</h3>
<StatusMessage />

<div class="row">
    <div class="col-xl-6">
        <EditForm Model="Input" FormName="profile" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <div class="form-floating mb-3">
                <input type="text" value="@username" id="username" class="form-control" disabled />
                <label for="username" class="form-label">@L["Email"]</label>
            </div>
            <div class="form-floating mb-1">
                <input type="text" value="@user?.DisplayName" id="display-name" class="form-control" disabled />
                <label for="display-name" class="form-label">@L["Display name (shown on leaderboards)"]</label>
            </div>
            <p class="form-text mb-3">@L["Display names are chosen when the account is created and can't be changed."]</p>
            <AvatarPicker @bind-Value="Input.Avatar" />
            <button type="submit" class="w-100 btn btn-lg btn-primary">@L["Save avatar"]</button>
        </EditForm>

        @if (user is not null)
        {
            <p class="mt-4">
                @L.Html("Games played: <strong>{0}</strong> · Games won: <strong>{1}</strong>", user.GamesPlayed, user.GamesWon)
                &middot; <a href="stats">@L["See your stats"]</a>
            </p>
        }
    </div>
</div>

@code {
    private ApplicationUser? user;
    private string? username;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        username = await UserManager.GetUserNameAsync(user);
        Input.Avatar ??= user.Avatar;
    }

    private async Task OnValidSubmitAsync()
    {
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        user.Avatar = Avatars.Find(Input.Avatar)?.Id ?? "";
        var result = await UserManager.UpdateAsync(user);
        if (!result.Succeeded)
        {
            RedirectManager.RedirectToCurrentPageWithStatus(L["Error: Failed to update your profile."], HttpContext);
            return;
        }

        // Refreshing the sign-in updates the avatar in the header (it travels in the sign-in cookie).
        await SignInManager.RefreshSignInAsync(user);
        RedirectManager.RedirectToCurrentPageWithStatus(L["Your avatar has been updated"], HttpContext);
    }

    private sealed class InputModel
    {
        public string? Avatar { get; set; }
    }
}
