@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using Mahjong.Web.Data

@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager

@*
    The sign-in services, three across: Google, Facebook and Apple, then any other configured service.
    One that isn't set up yet is shown greyed out ("soon"), so the screen already has its final shape.
*@
<form class="providers" action="Account/PerformExternalLogin" method="post">
    <AntiforgeryToken />
    <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
    @foreach (var name in Shown)
    {
        var scheme = externalLogins.FirstOrDefault(s => s.Name == name);
        string label = scheme?.DisplayName ?? name;
        if (scheme != null)
        {
            <button type="submit" class="provider @name.ToLowerInvariant()" name="provider" value="@name" title="@L["Log in using your {0} account", label]">
                @Logo(name)
                <span>@label</span>
            </button>
        }
        else
        {
            <button type="button" class="provider @name.ToLowerInvariant()" disabled aria-label="@L["{0} (coming soon)", label]">
                @Logo(name)
                <span>@label</span>
                <span class="soon">@L["soon"]</span>
            </button>
        }
    }
</form>

@code {
    private AuthenticationScheme[] externalLogins = [];

    // Always shown, in this order; Apple isn't wired up yet. Any other configured service follows.
    private static readonly string[] Planned = ["Google", "Facebook", "Apple"];

    private IEnumerable<string> Shown => Planned.Concat(externalLogins.Select(s => s.Name).Where(n => !Planned.Contains(n)));

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    // Each provider's own logo, as their sign-in button guidelines ask. Other providers get a plain button.
    private static RenderFragment Logo(string provider) => provider switch
    {
        "Google" => @<svg class="logo" viewBox="0 0 48 48" aria-hidden="true">
            <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" />
            <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" />
            <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z" />
            <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" />
        </svg>,
        "Microsoft" => @<svg class="logo" viewBox="0 0 21 21" aria-hidden="true">
            <rect x="1" y="1" width="9" height="9" fill="#F25022" />
            <rect x="11" y="1" width="9" height="9" fill="#7FBA00" />
            <rect x="1" y="11" width="9" height="9" fill="#00A4EF" />
            <rect x="11" y="11" width="9" height="9" fill="#FFB900" />
        </svg>,
        "Apple" => @<svg class="logo" viewBox="0 0 24 24" aria-hidden="true">
            <path fill="currentColor" d="M16.4 12.6c0-2.6 2.1-3.8 2.2-3.9-1.2-1.8-3.1-2-3.7-2-1.6-.2-3.1.9-3.9.9s-2-.9-3.4-.9c-1.7 0-3.3 1-4.2 2.6-1.8 3.1-.5 7.7 1.3 10.2.9 1.2 1.9 2.6 3.2 2.6 1.3-.1 1.8-.8 3.4-.8s2 .8 3.4.8 2.2-1.3 3.1-2.5c1-1.4 1.4-2.8 1.4-2.9 0 0-2.8-1.1-2.8-4.1zM13.9 5c.7-.9 1.2-2 1-3.2-1 0-2.3.7-3 1.5-.7.8-1.2 2-1.1 3.1 1.2.1 2.4-.6 3.1-1.4z" />
        </svg>,
        "Facebook" => @<svg class="logo" viewBox="0 0 24 24" aria-hidden="true">
            <path fill="currentColor" d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.09 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.69.23 2.69.23v2.97h-1.51c-1.49 0-1.96.93-1.96 1.89v2.26h3.33l-.53 3.49h-2.8V24C19.61 23.09 24 18.1 24 12.07z" />
        </svg>,
        _ => _ => { },
    };

    protected override async Task OnInitializedAsync()
    {
        externalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).ToArray();
    }
}
