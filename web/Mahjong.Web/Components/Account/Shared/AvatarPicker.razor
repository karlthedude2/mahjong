@using System.Linq.Expressions
@using Mahjong.Web.Client.Components
@using Mahjong.Web.Client.Game

@* Choose an avatar (or none): the twelve animals of the Chinese zodiac, as radio buttons in a grid. *@
<fieldset class="avatar-picker">
    <legend>@(Legend ?? L["Avatar"])</legend>
    <InputRadioGroup TValue="string" Value="@Value" ValueChanged="@ValueChanged" ValueExpression="@ValueExpression">
        <div class="choices">
            <label class="choice">
                <InputRadio Value="@("")" />
                <AvatarImage Id="" Size="56" />
                <span class="name">@L["None"]</span>
            </label>
            @foreach (var avatar in Avatars.All)
            {
                <label class="choice" title="@L[avatar.Name] (@avatar.Chinese)">
                    <InputRadio Value="@avatar.Id" />
                    <AvatarImage Id="@avatar.Id" Size="56" />
                    <span class="name">@L[avatar.Name] <span class="chinese">@avatar.Chinese</span></span>
                </label>
            }
        </div>
    </InputRadioGroup>
</fieldset>

@code {
    [Parameter] public string? Legend { get; set; }

    [Parameter] public string? Value { get; set; }

    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    [Parameter] public Expression<Func<string?>>? ValueExpression { get; set; }
}
