@inherits LayoutComponentBase
@inject NavigationManager Navigation

<TopNav />

<main class="content">
    @Body
</main>


<footer class="site-footer">
    <a href="privacy">@L["Privacy"]</a>
    <span>&copy; 2026 KabKolor</span>
</footer>

@* The home page's game fills the window with the footer; this follows, for anyone who scrolls on. *@
@if (IsHome)
{
    <HomeAbout />
}

<div id="blazor-error-ui" data-nosnippet>
    @L["An unhandled error has occurred."]
    <a href="." class="reload">@L["Reload"]</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    // The home page (the game, with any ?settings= or ?replay= on it).
    private bool IsHome => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Length == 0;
}
