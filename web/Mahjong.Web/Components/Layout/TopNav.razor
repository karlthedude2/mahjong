@implements IDisposable
@inject NavigationManager NavigationManager

<nav class="top-nav">
    <a class="brand" href="">Mahjong</a>
    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Play</NavLink>
    <NavLink class="nav-link" href="leaderboards">Leaderboards</NavLink>

    <span class="spacer"></span>

    <AuthorizeView>
        <Authorized>
            <NavLink class="nav-link" href="stats">My stats</NavLink>
            <NavLink class="nav-link" href="Account/Manage">@context.User.Identity?.Name</NavLink>
            <form action="Account/Logout" method="post">
                <AntiforgeryToken />
                <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                <button type="submit" class="nav-link">Sign out</button>
            </form>
        </Authorized>
        <NotAuthorized>
            <NavLink class="nav-link" href="Account/Login">Sign in</NavLink>
            <NavLink class="nav-link register" href="Account/Register">Create account</NavLink>
        </NotAuthorized>
    </AuthorizeView>
</nav>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose() => NavigationManager.LocationChanged -= OnLocationChanged;
}
