@implements IDisposable
@inject NavigationManager NavigationManager

@*
    Every link is an icon with a tooltip (data-tip, shown on hover and keyboard focus; see
    TopNav.razor.css) and an aria-label for screen readers, so the bar fits on a phone.
*@
<nav class="top-nav">
    <a class="brand" href="" aria-label="Mahjong Haus home">
        <img class="logo" src="logo.png" alt="" width="92" height="92" />
        <span class="brand-name">Mahjong Haus</span>
    </a>
    @* New game and Settings act in place on the game page (see App.razor); elsewhere they're links to it. *@
    <a class="icon-link" href="" data-play-action="new-game" aria-label="New game" data-tip="New game">
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="5.5" y="3" width="13" height="18" rx="2.5" />
            <path d="M12 8.5v7M8.5 12h7" />
        </svg>
    </a>
    <NavLink class="icon-link" href="leaderboards" aria-label="Leaderboards" data-tip="Leaderboards">
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M8 4h8v5a4 4 0 0 1-8 0z" />
            <path d="M8 6H5.5a2.5 2.5 0 0 0 2.8 4M16 6h2.5a2.5 2.5 0 0 1-2.8 4" />
            <path d="M12 13v4M8.5 20h7M9.5 17h5v3h-5z" />
        </svg>
    </NavLink>

    <span class="spacer"></span>

    <div class="right">
        <a class="icon-link" href="?settings=1" data-play-action="settings" aria-label="Settings" data-tip="Settings">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="3" />
                <path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z" />
            </svg>
        </a>
        @* Toggled by the script in App.razor, which also swaps the label; the setting is kept in the browser. *@
        <button type="button" class="icon-link sound-toggle" aria-label="Mute sound" data-tip="Mute sound">
            <svg class="icon-sound-on" viewBox="0 0 24 24" aria-hidden="true">
                <path class="speaker" d="M4 9h4l5-4v14l-5-4H4z" />
                <path d="M16 9.5a3.5 3.5 0 0 1 0 5" />
                <path d="M18.5 7a7 7 0 0 1 0 10" />
            </svg>
            <svg class="icon-sound-off" viewBox="0 0 24 24" aria-hidden="true">
                <path class="speaker" d="M4 9h4l5-4v14l-5-4H4z" />
                <path d="M16.5 9.5l5 5M21.5 9.5l-5 5" />
            </svg>
        </button>

        <AuthorizeView>
            <Authorized>
                <NavLink class="icon-link" href="stats" aria-label="My stats" data-tip="My stats">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M4 20h16M7 16v-5M12 16V6M17 16v-8" />
                    </svg>
                </NavLink>
                <NavLink class="icon-link" href="Account/Manage" aria-label="Your account" data-tip="@($"Account ({context.User.Identity?.Name})")">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="12" cy="8" r="4" />
                        <path d="M4 21a8 8 0 0 1 16 0" />
                    </svg>
                </NavLink>
                <form action="Account/Logout" method="post">
                    <AntiforgeryToken />
                    <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                    <button type="submit" class="icon-link" aria-label="Sign out" data-tip="Sign out">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M14 4h5v16h-5M10 8l-4 4 4 4M6 12h10" />
                        </svg>
                    </button>
                </form>
            </Authorized>
            <NotAuthorized>
                <NavLink class="icon-link" href="Account/Login" aria-label="Sign in" data-tip="Sign in">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M14 4h5v16h-5M10 8l4 4-4 4M4 12h10" />
                    </svg>
                </NavLink>
                <NavLink class="icon-link register" href="Account/Register" aria-label="Create account" data-tip="Create account">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="10" cy="8" r="4" />
                        <path d="M3 21a7 7 0 0 1 14 0M19 8v6M16 11h6" />
                    </svg>
                </NavLink>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</nav>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose() => NavigationManager.LocationChanged -= OnLocationChanged;
}
