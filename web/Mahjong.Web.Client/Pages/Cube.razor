@page "/cube"
@using Mahjong.Web.Client.Game
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject FaceArt FaceArt

@*
    Prototype: Mahjong Cube, a 3D game drawn with Three.js (wwwroot/js/cube.js). Not linked from the
    menus yet. The game and its rules are CubeGame; the script only draws the block, turns it, and
    reports which tile was tapped.
*@

<PageTitle>@L["Mahjong Cube"]</PageTitle>

<section class="cube-page">
    <div class="cube-bar">
        <span class="cube-title">@L["Mahjong Cube"] <span class="badge">@L["Prototype"]</span></span>
        <span class="cube-count">@L["{0} left", game?.Tiles.Count ?? 0]</span>
        <span class="cube-sizes" role="radiogroup" aria-label="@L["Board size"]">
            <button type="button" role="radio" aria-checked="@(size == 4 ? "true" : "false")" class="@(size == 4 ? "on" : null)" @onclick="() => NewGameAsync(4)">@L["Small"] (4×4×4)</button>
            <button type="button" role="radio" aria-checked="@(size == 6 ? "true" : "false")" class="@(size == 6 ? "on" : null)" @onclick="() => NewGameAsync(6)">@L["Large"] (6×6×6)</button>
        </span>
        @* Development: pictures dropped into the cube-stones folder are listed too (see DevStoneEndpoints). *@
        @* The same stones as Mahjong 3D (TileSets.Stones). *@
        <select class="cube-stone" aria-label="@L["Material"]" value="@stone" @onchange="@(e => SetStoneAsync(e.Value as string ?? DefaultStone))">
            @foreach (var set in TileSets.Stones)
            {
                <option value="@set.Stone">@L[set.Name]</option>
            }
            @if (droppedStones.Count > 0)
            {
                <optgroup label="@L["From the cube-stones folder"]">
                    @foreach (var file in droppedStones)
                    {
                        <option value="@(DroppedPrefix + file)">@Path.GetFileNameWithoutExtension(file)</option>
                    }
                </optgroup>
            }
        </select>
        <button type="button" class="btn btn-sm btn-light" @onclick="HintAsync" disabled="@(game is null || game.IsCleared)">@L["Hint"]</button>
        <button type="button" class="btn btn-sm btn-primary" @onclick="() => NewGameAsync(size)">@L["New game"]</button>
    </div>

    @if (message != null)
    {
        <div class="cube-message">@message</div>
    }

    <div class="cube-view" @ref="view" role="img" aria-label="@L["Mahjong Cube"]"></div>

    <p class="cube-help">@L["Drag to turn the cube. A tile can be taken when two of its sides that meet at an edge are open."]</p>
</section>

@code {
    private ElementReference view;
    private IJSObjectReference? module;
    private IJSObjectReference? scene;
    private DotNetObjectReference<Cube>? self;
    private CubeGame? game;
    private CubeTile? selected;
    private (CubeTile, CubeTile)? hint;
    private string? message;
    private int size = 4;
    private static readonly string DefaultStone = TileSets.DefaultStone.Stone!;
    private string stone = DefaultStone;
    private List<string> droppedStones = [];

    private const string DroppedPrefix = "file:";
    private const string StoneSetting = "mahjong.cubeStone";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            self = DotNetObjectReference.Create(this);
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/cube.js");
            scene = await module.InvokeAsync<IJSObjectReference>("create", view, self);
            // Face art and each stone's face set (see FaceArt), and stone pictures to try.
            await FaceArt.LoadAsync();
            droppedStones = await FaceArt.ListAsync("dev/stones");

            // The last stone chosen, so a refresh after dropping in a new picture keeps the view.
            string? saved = await JS.InvokeAsync<string?>("localStorage.getItem", StoneSetting);
            if (TileSets.Stones.Any(s => s.Stone == saved) || saved?.StartsWith(DroppedPrefix) == true && droppedStones.Contains(saved[DroppedPrefix.Length..]))
            {
                stone = saved;
            }

            await ShowStoneAsync();
            await NewGameAsync(size);
        }
    }

    private async Task NewGameAsync(int newSize)
    {
        size = newSize;
        game = CubeGame.Deal(size, new Random());
        selected = null;
        hint = null;
        message = null;
        if (scene != null)
        {
            var tiles = game.Tiles.Select(t =>
            {
                var glyph = TileSets.Glyph(t.Face.Name);
                return new
                {
                    id = t.Id, x = t.X, y = t.Y, z = t.Z, face = t.Face.Name,
                    art = FaceArt.Pictures(t.Face.Name),
                    glyph = new { main = glyph.Main, caption = L[glyph.Caption].Value, color = glyph.ColorClass },
                };
            });
            await scene.InvokeVoidAsync("setBoard", size, tiles, FreeIds());
        }

        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnTileTapped(int id)
    {
        var tile = game?.Tiles.FirstOrDefault(t => t.Id == id);
        if (game == null || tile == null || !game.IsFree(tile))
        {
            return;
        }

        if (selected == null || selected == tile)
        {
            selected = selected == tile ? null : tile;
        }
        else if (game.TryRemovePair(selected, tile))
        {
            await scene!.InvokeVoidAsync("remove", new[] { selected.Id, tile.Id });
            selected = null;
            hint = null;
            message = game.IsCleared ? L["You cleared the cube!"].Value
                : game.FindPair() == null ? L["No pairs can be taken. Start a new game."].Value
                : null;
        }
        else
        {
            selected = tile;
        }

        await RedrawAsync();
    }

    private async Task SetStoneAsync(string name)
    {
        stone = name;
        await ShowStoneAsync();
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", StoneSetting, stone);
        }
        catch (JSException)
        {
            // Private windows or blocked storage: the choice just isn't remembered.
        }
    }

    private async Task ShowStoneAsync()
    {
        if (scene != null)
        {
            string? url = stone.StartsWith(DroppedPrefix) ? "dev/stones/" + Uri.EscapeDataString(stone[DroppedPrefix.Length..]) : null;
            // A built-in stone is configured by its name, a picture being tried by its file name.
            string? faces = FaceArt.StoneFaces(stone.StartsWith(DroppedPrefix) ? stone[DroppedPrefix.Length..] : stone);
            await scene.InvokeVoidAsync("setStone", stone, url, faces);
        }
    }

    private async Task HintAsync()
    {
        hint = game?.FindPair();
        message = hint == null ? L["No pairs can be taken. Start a new game."].Value : null;
        await RedrawAsync();
    }

    private async Task RedrawAsync()
    {
        if (scene != null)
        {
            int[] hinted = hint is { } pair ? [pair.Item1.Id, pair.Item2.Id] : [];
            await scene.InvokeVoidAsync("update", selected?.Id, FreeIds(), hinted);
        }

        StateHasChanged();
    }

    private int[] FreeIds() => game == null ? [] : game.Tiles.Where(game.IsFree).Select(t => t.Id).ToArray();

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (scene != null)
            {
                await scene.InvokeVoidAsync("dispose");
                await scene.DisposeAsync();
            }

            if (module != null)
            {
                await module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }

        self?.Dispose();
    }
}
