@page "/"
@using Mahjong.Core
@using Mahjong.Web.Client.Api
@using Mahjong.Web.Client.Components
@using Mahjong.Web.Client.Game
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@implements IDisposable
@inject GameSession Session
@inject PlayerPreferences Preferences
@inject GameApi Api
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Navigation
@inject GuestClaims GuestClaims
@inject BrowserInterop Browser

<PageTitle>Mahjong</PageTitle>

<div class="play-page @(signedIn ? "signed-in" : "guest")">
    @if (!signedIn)
    {
        <aside class="ad-rail left" aria-label="Advertisement">
            <AdSlot ClientId="@config?.AdsClientId" SlotId="@config?.AdSlotRail" Format="vertical" />
        </aside>
    }

    <section class="game">
        @* The board column: title, messages, the score bar, then the board and its controls. *@
        <div class="play-table">
            <div class="board-column">
                <div class="layout-title">
                    @PlayingLayout?.Name
                    @if (Session.Game is { Winnable: false })
                    {
                        <span class="deal-badge" title="Tiles were dealt at random, so this deal may not be clearable.">Random deal</span>
                    }
                </div>

                @if (!signedIn)
                {
                    <div class="notice">Playing as a guest. <a href="Account/Login">Sign in</a> to save your scores and stats.</div>
                }

                @if (Session.IsDemo && !Session.DemoEnded)
                {
                    <div class="notice info demo-bar">
                        <span><strong>Demo:</strong> the computer is playing this deal. It won't go on the leaderboard.</span>
                        <span class="demo-speed" role="radiogroup" aria-label="Demo speed">
                            @foreach (var (label, pace) in DemoSpeeds)
                            {
                                <button type="button" role="radio" aria-checked="@(Session.DemoPace == pace ? "true" : "false")"
                                        class="@(Session.DemoPace == pace ? "on" : null)" @onclick="() => Session.DemoPace = pace">@label</button>
                            }
                        </span>
                        <button class="btn btn-sm btn-primary" @onclick="Session.StopDemo">Stop demo</button>
                    </div>
                }

                @if (Session.IsPractice)
                {
                    <div class="notice info">
                        <strong>Practice:</strong> the deal from the demo. This game won't go on the leaderboard.
                        <button class="btn btn-link btn-sm" @onclick="RequestNewGameAsync">New game</button>
                    </div>
                }

                @if (claimed != null)
                {
                    <div class="notice info">
                        Your guest win on @claimed.Layout (@claimed.Score.ToString("N0")) has been saved to your account.
                        @if (claimed.Rank is { } claimedRank)
                        {
                            <span>You're <strong>#@claimedRank</strong> on the <a href="leaderboards?layout=@Uri.EscapeDataString(claimed.Layout)">@claimed.Layout leaderboard</a>!</span>
                        }
                        else if (claimed.ReplayRank is { } claimedReplayRank)
                        {
                            <span>You're <strong>#@claimedReplayRank</strong> on that deal's <a href="replays/@claimed.ReplayOf">replay list</a>!</span>
                        }
                        <button class="btn btn-link btn-sm" @onclick="() => claimed = null">OK</button>
                    </div>
                }

                @if (replay != null)
                {
                    <div class="notice info">
                        Replaying <strong>@replay.OriginalPlayer</strong>'s @replay.Layout deal. Score to beat:
                        <strong>@replay.OriginalScore.ToString("N0")</strong>. Replays go on this deal's own list, never the main leaderboard.
                        @if (!signedIn)
                        {
                            <span><a href="Account/Login">Sign in</a> to get your score on the list.</span>
                        }
                        <a class="btn btn-link btn-sm" href="replays/@replay.OriginalGameId">See replay scores</a>
                        <button class="btn btn-link btn-sm" @onclick="NewGameAsync">Back to normal play</button>
                    </div>
                }

                @if (pendingDealChange)
                {
                    <div class="notice info">
                        Your next game will be @(Preferences.GuaranteedWinnable ? "a guaranteed winnable deal" : "a random deal").
                        <button class="btn btn-link btn-sm" @onclick="NewGameAsync">Start it now</button>
                    </div>
                }

                @if (pendingLayout != null)
                {
                    <div class="notice info">
                        Your next game will use the <strong>@pendingLayout.Name</strong> layout.
                        <button class="btn btn-link btn-sm" @onclick="NewGameAsync">Start it now</button>
                        <button class="btn btn-link btn-sm" @onclick="() => pendingLayout = null">Keep @currentLayout?.Name</button>
                    </div>
                }

                @if (error != null)
                {
                    <div class="notice warning">@error</div>
                }

                @if (Session.Message != null)
                {
                    <div class="notice warning">@Session.Message</div>
                }

                @if (Session.State == SessionState.NoMovesLeft)
                {
                    <div class="notice warning">
                        No more matching pairs. Try <strong>Shuffle</strong> or <strong>Undo</strong>.
                        @if (Session.Game is { Winnable: false })
                        {
                            <span>(Random deals can't always be cleared.)</span>
                        }
                    </div>
                }

                @if (Session.Game is { } game)
                {
                    @* As wide as the board is drawn (see matchBoardWidth in mahjong.js). *@
                    <div class="score-bar" @ref="scoreBar">
                        <ScorePanel Game="game" ClockStarted="Session.ClockStarted" />
                    </div>

                    <div class="board-area" @ref="boardArea">
                        @if (Session.State == SessionState.Paused)
                        {
                            <div class="paused">Paused</div>
                        }
                        else
                        {
                            <Board @key="game" Game="game" Selected="Session.Selected" TileSet="Preferences.TileSet" OnTileClick="Session.ClickAsync"
                               Path="Session.LastPath" Hinted="Session.HintedTiles" />
                        }
                    </div>

                    @* The game's controls: icons with tooltips (data-tip) on a rounded bar under the board. *@
                    <div class="game-controls" role="toolbar" aria-label="Game controls">
                        <button type="button" @onclick="Session.ShuffleAsync" disabled="@(!CanPlay)"
                                aria-label="Shuffle" data-tip="Shuffle (costs 1,000 of the no-shuffle bonus)">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M4 7h3.5c3.5 0 5.5 10 9 10H20M4 17h3.5c1.4 0 2.5-1.6 3.4-3.4M13.1 10.4C14 8.6 15.1 7 16.5 7H20M17 4l3 3-3 3M17 14l3 3-3 3" />
                            </svg>
                        </button>
                        <button type="button" @onclick="Session.UndoAsync" disabled="@(!CanPlay || Session.Game?.CanUndo != true)"
                                aria-label="Undo" data-tip="Undo">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M9 14L4 9l5-5M4 9h10.5a5.5 5.5 0 0 1 0 11H11" />
                            </svg>
                        </button>
                        <button type="button" @onclick="Session.RedoAsync" disabled="@(!CanPlay || Session.Game?.CanRedo != true)"
                                aria-label="Redo" data-tip="Redo">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M15 14l5-5-5-5M20 9H9.5a5.5 5.5 0 0 0 0 11H13" />
                            </svg>
                        </button>
                        <button type="button" @onclick="Session.HintAsync" disabled="@(!CanPlay)"
                                aria-label="Hint" data-tip="Hint (costs 500 of the no-shuffle bonus)">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.6 10.8c.6.5 1.1 1.3 1.1 2.2h5c0-.9.5-1.7 1.1-2.2A6 6 0 0 0 12 3z" />
                            </svg>
                        </button>
                        <button type="button" @onclick="RequestDemoAsync" disabled="@(Session.IsDemo || Session.Game == null)"
                                aria-label="Watch a demo" data-tip="Watch the computer play this deal (not ranked)">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z" />
                                <circle cx="12" cy="12" r="3" />
                            </svg>
                        </button>
                        @if (Session.State == SessionState.Paused)
                        {
                            <button type="button" @onclick="Session.TogglePauseAsync" disabled="@(!Session.CanPause)" aria-label="Resume" data-tip="Resume">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path class="solid" d="M8 5v14l11-7z" />
                                </svg>
                            </button>
                        }
                        else
                        {
                            <button type="button" @onclick="Session.TogglePauseAsync" disabled="@(!Session.CanPause)" aria-label="Pause" data-tip="Pause">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M9 5v14M15 5v14" />
                                </svg>
                            </button>
                        }
                    </div>
                }
                else
                {
                    <div class="loading">Dealing&hellip;</div>
                }
            </div>
        </div>
    </section>

    <aside class="ad-rail right" aria-label="Advertisement">
        <AdSlot ClientId="@config?.AdsClientId" SlotId="@config?.AdSlotRail" Format="vertical" />
    </aside>

    <aside class="ad-banner" aria-label="Advertisement">
        <AdSlot ClientId="@config?.AdsClientId" SlotId="@config?.AdSlotBanner" Format="horizontal" />
    </aside>
</div>

@if (confirmDemo)
{
    <div class="demo-backdrop" @onclick="() => confirmDemo = false">
        <div class="demo-dialog" role="dialog" aria-modal="true" aria-labelledby="demo-confirm-title" @onclick:stopPropagation="true">
            <h2 id="demo-confirm-title">Watch a demo?</h2>
            <p>The computer will play this deal from the start. Your current game ends here and won't be saved.</p>
            <div class="actions">
                <button class="btn btn-light" @onclick="() => confirmDemo = false">Keep playing</button>
                <button class="btn btn-primary" @onclick="StartDemoAsync">Watch the demo</button>
            </div>
        </div>
    </div>
}

@if (Session.IsDemo && Session.DemoEnded && demoDeal is { } watched)
{
    <div class="demo-backdrop">
        <div class="demo-dialog" role="dialog" aria-modal="true" aria-labelledby="demo-done-title">
            <h2 id="demo-done-title">@(Session.Game?.Board.IsComplete == true ? "Demo finished" : "Demo stopped")</h2>
            <p>
                @(Session.DemoNote ?? (Session.Game?.Board.IsComplete == true
                    ? $"The computer cleared {watched.Layout.Name}. Now try the same deal yourself."
                    : "You can try this deal yourself from the start."))
                It's practice, so it won't go on the leaderboard.
            </p>
            <div class="actions">
                <button class="btn btn-light" @onclick="RequestNewGameAsync">New game</button>
                <button class="btn btn-primary" @onclick="PracticeAsync">Play this deal</button>
            </div>
        </div>
    </div>
}

@if (Session.State == SessionState.Won && !Session.IsDemo && PlayingLayout != null)
{
    <ResultsDialog Session="Session" Config="config" LayoutName="@PlayingLayout.Name" OnPlayAgain="PlayAgainAsync" />
}

@if (showLeaderboard)
{
    <LeaderboardDialog Layouts="AllLayouts.ToList()" LayoutName="@PlayingLayout?.Name" OnClose="() => showLeaderboard = false" />
}

@if (showSettings)
{
    <SettingsDialog Layouts="layouts" PlayingLayoutName="@(Session.Game != null ? PlayingLayout?.Name : null)" LayoutName="@((pendingLayout ?? currentLayout)?.Name)"
                    TileSetId="@Preferences.TileSet.Id" BackgroundId="@Preferences.Background.Id"
                    SkipSettings="Preferences.SkipSettings" GuaranteedWinnable="Preferences.GuaranteedWinnable" ForNewGame="settingsForNewGame"
                    OnApply="ApplySettingsAsync" OnCancel="CancelSettingsAsync" />
}

@code {
    private const string DefaultLayoutName = "Twin Peaks";

    private bool signedIn;
    private ClientConfig? config;
    private IReadOnlyList<LayoutDefinition> layouts = LayoutCatalog.Visible;

    // Solitaire layouts and Connect boards: anything the player can choose.
    private IEnumerable<LayoutDefinition> AllLayouts => layouts.Concat(LayoutCatalog.Connect);
    private LayoutDefinition? currentLayout;
    // A layout chosen mid-game, kept for the next game so the current one isn't interrupted.
    private LayoutDefinition? pendingLayout;
    private bool showSettings;
    private bool showLeaderboard;
    // The dialog is open to pick settings for a new game, which is dealt when it closes.
    private bool settingsForNewGame;
    // The deal setting was changed mid-game; it applies from the next game.
    private bool pendingDealChange;
    private DotNetObjectReference<Play>? selfReference;
    private ElementReference scoreBar;
    private ElementReference boardArea;
    private IJSObjectReference? boardWidthWatcher;
    private string? error;
    // The leaderboard deal being replayed (from ?replay=<game id>), or null in normal play.
    private ReplayInfo? replay;
    private LayoutDefinition? replayLayout;
    // A guest win saved to the account after signing in, to tell the player about.
    private ClaimGameResponse? claimed;

    [SupplyParameterFromQuery(Name = "replay")]
    public Guid? ReplayId { get; set; }

    // ?settings=1: the header's gear, clicked on another page.
    [SupplyParameterFromQuery(Name = "settings")]
    public string? SettingsRequested { get; set; }

    // The layout on the board: the replay's, or the player's own choice.
    // The layout on the board (a replay's, a demo's, or the player's own choice).
    private LayoutDefinition? PlayingLayout => Session.Game?.Layout ?? (replay != null ? replayLayout : currentLayout);

    // Demos: the deal being watched (to practise afterwards), and the speeds on offer (ms per pair).
    private (LayoutDefinition Layout, long Seed, bool Winnable)? demoDeal;
    private bool confirmDemo;
    private static readonly (string Label, int Pace)[] DemoSpeeds = [("Slow", 1400), ("Normal", 800), ("Fast", 300)];

    private bool CanPlay => Session.State is SessionState.Playing or SessionState.NoMovesLeft;

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnSessionChanged;
        await Session.PreloadEffectsAsync();

        var auth = await AuthState.GetAuthenticationStateAsync();
        signedIn = auth.User.Identity?.IsAuthenticated == true;

        config = await Api.GetConfigAsync();
        layouts = config.ShowHiddenLayouts ? LayoutCatalog.All : LayoutCatalog.Visible;

        await Preferences.LoadAsync(signedIn);
        if (signedIn)
        {
            claimed = await GuestClaims.ClaimPendingAsync();
        }

        currentLayout = AllLayouts.FirstOrDefault(l => l.Name == Preferences.LastLayout)
            ?? layouts.FirstOrDefault(l => l.Name == DefaultLayoutName)
            ?? layouts[0];

        if (ReplayId is { } replayId)
        {
            var info = await Api.GetReplayAsync(replayId);
            if (info != null && LayoutCatalog.Find(info.Layout) is { } layout)
            {
                replay = info;
                replayLayout = layout;
                await PlayReplayAsync();
                return;
            }

            error = "That deal couldn't be found, so here's a new game instead.";
        }

        // Guests always start by choosing their settings; signed-in players unless they've turned that off.
        if (!signedIn || !Preferences.SkipSettings)
        {
            settingsForNewGame = true;
            showSettings = true;
        }
        else
        {
            await NewGameAsync();
            if (SettingsRequested != null)
            {
                showSettings = true;
            }
        }

        if (SettingsRequested != null)
        {
            Navigation.NavigateTo("", replace: true);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            selfReference = DotNetObjectReference.Create(this);
            await Browser.SetPlayActionsAsync(selfReference);
        }

        // The score bar and board appear with the first game; from then on they stay.
        if (boardWidthWatcher == null && Session.Game != null && boardArea.Context != null)
        {
            boardWidthWatcher = await Browser.MatchBoardWidthAsync(boardArea, scoreBar);
        }
    }

    /// <summary>The header's New game ("new-game"), Leaderboards ("leaderboards") and Settings ("settings"), while this page is showing.</summary>
    [JSInvokable]
    public async Task OnHeaderAction(string action)
    {
        if (action == "new-game")
        {
            await RequestNewGameAsync();
        }
        else if (action == "leaderboards")
        {
            // Pause a running game first; closing the leaderboard leaves it paused, ready to resume.
            if (Session.CanPause && Session.State != SessionState.Paused)
            {
                await Session.TogglePauseAsync();
            }

            showLeaderboard = true;
        }
        else if (action == "settings")
        {
            settingsForNewGame = false;
            showSettings = true;
        }

        StateHasChanged();
    }

    // New game (and Play again): choose settings first, unless the player has turned that off.
    private async Task RequestNewGameAsync()
    {
        if (Preferences.SkipSettings)
        {
            await NewGameAsync();
        }
        else
        {
            settingsForNewGame = true;
            showSettings = true;
        }
    }

    private Task PlayAgainAsync() => Session.IsPractice ? PracticeAsync() : replay != null ? PlayReplayAsync() : RequestNewGameAsync();

    // Watch: straight away if nothing's been played, otherwise after asking (the game in progress ends).
    private async Task RequestDemoAsync()
    {
        if (GameUnderWay && !Session.IsPractice)
        {
            confirmDemo = true;
        }
        else
        {
            await StartDemoAsync();
        }
    }

    private async Task StartDemoAsync()
    {
        confirmDemo = false;
        if (Session.Deal is not { } deal)
        {
            return;
        }

        demoDeal = deal;
        LeaveReplay();
        await Session.StartDemoAsync(deal.Layout, deal.Seed, deal.Winnable);
    }

    // The watched deal, for the player to try: in the browser only, never ranked.
    private async Task PracticeAsync()
    {
        if (demoDeal is { } deal)
        {
            await Session.StartPracticeAsync(deal.Layout, deal.Seed, deal.Winnable);
        }
    }

    // Replay mode ends (e.g. for a demo); ?replay= goes from the address so a reload doesn't return to it.
    private void LeaveReplay()
    {
        if (replay != null)
        {
            replay = null;
            replayLayout = null;
            Navigation.NavigateTo("", replace: true);
        }
    }

    // Deals the replayed game's tiles. Signed-in players' replays are verified and ranked on the
    // deal's replay list; once the original drops off the leaderboard, replays are just for fun.
    private async Task PlayReplayAsync()
    {
        error = null;
        var mode = !replay!.CanPlay ? GameMode.Offline : signedIn ? GameMode.SignedIn : GameMode.Guest;
        try
        {
            await Session.StartAsync(replayLayout!, mode, replay);
        }
        catch (HttpRequestException e)
        {
            if (signedIn)
            {
                error = e.StatusCode == System.Net.HttpStatusCode.NotFound
                    ? "This deal is no longer on the leaderboard, so this replay won't be saved."
                    : "Couldn't reach the server, so this game won't be saved.";
            }

            await Session.StartAsync(replayLayout!, GameMode.Offline, replay);
        }

        if (signedIn && !replay!.CanPlay && error == null)
        {
            error = "This deal is no longer on the leaderboard, so this replay won't be saved.";
        }
    }

    // A game counts as under way once the first tile is clicked (that starts the clock).
    private bool GameUnderWay => Session.Game != null && Session.State != SessionState.Won && Session.ClockStarted;

    private async Task NewGameAsync()
    {
        LeaveReplay();
        demoDeal = null;

        if (pendingLayout != null)
        {
            currentLayout = pendingLayout;
            pendingLayout = null;
        }

        pendingDealChange = false;

        error = null;
        try
        {
            await Session.StartAsync(currentLayout!, signedIn ? GameMode.SignedIn : GameMode.Guest, randomDeal: !Preferences.GuaranteedWinnable);
        }
        catch (HttpRequestException)
        {
            // If the server can't start the game, still let them play (it just can't be saved).
            if (signedIn)
            {
                error = "Couldn't reach the server, so this game won't be saved.";
            }

            await Session.StartAsync(currentLayout!, GameMode.Offline, randomDeal: !Preferences.GuaranteedWinnable);
        }
    }

    // Tiles and background change straight away; a new layout waits for the next game if one is under way.
    private async Task ApplySettingsAsync(SettingsChoice choice)
    {
        showSettings = false;

        if (choice.SkipSettings != Preferences.SkipSettings)
        {
            await Preferences.SetSkipSettingsAsync(choice.SkipSettings);
        }

        bool dealChanged = choice.GuaranteedWinnable != Preferences.GuaranteedWinnable;
        if (dealChanged)
        {
            await Preferences.SetGuaranteedWinnableAsync(choice.GuaranteedWinnable);
        }

        if (choice.TileSetId != Preferences.TileSet.Id)
        {
            await Preferences.SetTileSetAsync(TileSets.Find(choice.TileSetId));
        }

        if (choice.BackgroundId != Preferences.Background.Id)
        {
            await Preferences.SetBackgroundAsync(Backgrounds.Find(choice.BackgroundId));
        }

        var layout = AllLayouts.FirstOrDefault(l => l.Name == choice.LayoutName);
        if (settingsForNewGame)
        {
            // Settings for a new game: deal it with the chosen layout.
            settingsForNewGame = false;
            if (layout != null)
            {
                currentLayout = layout;
                pendingLayout = null;
                await Preferences.SetLastLayoutAsync(layout.Name);
            }

            await NewGameAsync();
            return;
        }

        if (layout is null || layout == (pendingLayout ?? currentLayout))
        {
            // Only the deal setting changed: redeal now if nothing's been played, otherwise next game.
            if (dealChanged && replay == null && !GameUnderWay)
            {
                await NewGameAsync();
            }
            else if (dealChanged)
            {
                pendingDealChange = true;
            }

            return;
        }

        if (dealChanged && (GameUnderWay || replay != null))
        {
            pendingDealChange = true;
        }

        await Preferences.SetLastLayoutAsync(layout.Name);
        if (layout == currentLayout)
        {
            pendingLayout = null;
        }
        else if (GameUnderWay || replay != null)
        {
            pendingLayout = layout;
        }
        else
        {
            pendingLayout = layout;
            await NewGameAsync();
        }
    }

    // Cancel keeps the game on the board; if there isn't one yet (the dialog opened as the page
    // loaded), deal one with the current settings.
    private async Task CancelSettingsAsync()
    {
        showSettings = false;
        settingsForNewGame = false;
        if (Session.Game == null)
        {
            await NewGameAsync();
        }
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
        Session.Dispose();
        _ = Browser.SetPlayActionsAsync(null).AsTask();
        _ = boardWidthWatcher?.InvokeVoidAsync("dispose").AsTask();
        selfReference?.Dispose();
    }
}
