@page "/"
@using Mahjong.Core
@using Mahjong.Web.Client.Api
@using Mahjong.Web.Client.Components
@using Mahjong.Web.Client.Game
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@implements IDisposable
@inject GameSession Session
@inject PlayerPreferences Preferences
@inject GameApi Api
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Navigation
@inject GuestClaims GuestClaims

<PageTitle>Mahjong</PageTitle>

<div class="play-page @(signedIn ? "signed-in" : "guest")">
    @if (!signedIn)
    {
        <aside class="ad-rail left" aria-label="Advertisement">
            <AdSlot ClientId="@config?.AdsClientId" SlotId="@config?.AdSlotRail" Format="vertical" />
        </aside>
    }

    <section class="game">
        <div class="toolbar">
            <button class="btn btn-sm btn-light" @onclick="() => showSettings = true" title="Layout, tiles and background">&#9881; Settings</button>
            <button class="btn btn-sm btn-light" @onclick="NewGameAsync">New game</button>
            <button class="btn btn-sm btn-light" @onclick="Session.ShuffleAsync" disabled="@(!CanPlay)" title="Redeals the remaining tiles. Costs 1,000 of the no-shuffle bonus.">Shuffle</button>
            <button class="btn btn-sm btn-light" @onclick="Session.UndoAsync" disabled="@(!CanPlay || Session.Game?.CanUndo != true)">Undo</button>
            <button class="btn btn-sm btn-light" @onclick="Session.RedoAsync" disabled="@(!CanPlay || Session.Game?.CanRedo != true)">Redo</button>
            <button class="btn btn-sm btn-light" @onclick="Session.TogglePauseAsync" disabled="@(!Session.CanPause)">
                @(Session.State == SessionState.Paused ? "Resume" : "Pause")
            </button>
            <span class="layout-name">@PlayingLayout?.Name</span>
        </div>

        @if (!signedIn)
        {
            <div class="notice">Playing as a guest. <a href="Account/Login">Sign in</a> to save your scores and stats.</div>
        }

        @if (claimed != null)
        {
            <div class="notice info">
                Your guest win on @claimed.Layout (@claimed.Score.ToString("N0")) has been saved to your account.
                @if (claimed.Rank is { } claimedRank)
                {
                    <span>You're <strong>#@claimedRank</strong> on the <a href="leaderboards?layout=@Uri.EscapeDataString(claimed.Layout)">@claimed.Layout leaderboard</a>!</span>
                }
                else if (claimed.ReplayRank is { } claimedReplayRank)
                {
                    <span>You're <strong>#@claimedReplayRank</strong> on that deal's <a href="replays/@claimed.ReplayOf">replay list</a>!</span>
                }
                <button class="btn btn-link btn-sm" @onclick="() => claimed = null">OK</button>
            </div>
        }

        @if (replay != null)
        {
            <div class="notice info">
                Replaying <strong>@replay.OriginalPlayer</strong>'s @replay.Layout deal. Score to beat:
                <strong>@replay.OriginalScore.ToString("N0")</strong>. Replays go on this deal's own list, never the main leaderboard.
                @if (!signedIn)
                {
                    <span><a href="Account/Login">Sign in</a> to get your score on the list.</span>
                }
                <a class="btn btn-link btn-sm" href="replays/@replay.OriginalGameId">See replay scores</a>
                <button class="btn btn-link btn-sm" @onclick="NewGameAsync">Back to normal play</button>
            </div>
        }

        @if (pendingLayout != null)
        {
            <div class="notice info">
                Your next game will use the <strong>@pendingLayout.Name</strong> layout.
                <button class="btn btn-link btn-sm" @onclick="NewGameAsync">Start it now</button>
                <button class="btn btn-link btn-sm" @onclick="() => pendingLayout = null">Keep @currentLayout?.Name</button>
            </div>
        }

        @if (error != null)
        {
            <div class="notice warning">@error</div>
        }

        @if (Session.Message != null)
        {
            <div class="notice warning">@Session.Message</div>
        }

        @if (Session.State == SessionState.NoMovesLeft)
        {
            <div class="notice warning">No more matching pairs. Try <strong>Shuffle</strong> or <strong>Undo</strong>.</div>
        }

        <div class="play-table">
            @if (Session.Game is { } game)
            {
                <div class="board-area">
                    @if (Session.State == SessionState.Paused)
                    {
                        <div class="paused">Paused</div>
                    }
                    else
                    {
                        <Board Game="game" Selected="Session.Selected" TileSet="Preferences.TileSet" OnTileClick="Session.ClickAsync" />
                    }
                </div>
                <ScorePanel Game="game" ClockStarted="Session.ClockStarted" />
            }
            else
            {
                <div class="loading">Dealing&hellip;</div>
            }
        </div>
    </section>

    <aside class="ad-rail right" aria-label="Advertisement">
        <AdSlot ClientId="@config?.AdsClientId" SlotId="@config?.AdSlotRail" Format="vertical" />
    </aside>

    <aside class="ad-banner" aria-label="Advertisement">
        <AdSlot ClientId="@config?.AdsClientId" SlotId="@config?.AdSlotBanner" Format="horizontal" />
    </aside>
</div>

@if (Session.State == SessionState.Won && PlayingLayout != null)
{
    <ResultsDialog Session="Session" Config="config" LayoutName="@PlayingLayout.Name" OnPlayAgain="PlayAgainAsync" />
}

@if (showSettings)
{
    <SettingsDialog Layouts="layouts" PlayingLayoutName="@PlayingLayout?.Name" LayoutName="@((pendingLayout ?? currentLayout)?.Name)"
                    TileSetId="@Preferences.TileSet.Id" BackgroundId="@Preferences.Background.Id"
                    OnApply="ApplySettingsAsync" OnCancel="() => showSettings = false" />
}

@code {
    private const string DefaultLayoutName = "Twin Peaks";

    private bool signedIn;
    private ClientConfig? config;
    private IReadOnlyList<LayoutDefinition> layouts = LayoutCatalog.Visible;
    private LayoutDefinition? currentLayout;
    // A layout chosen mid-game, kept for the next game so the current one isn't interrupted.
    private LayoutDefinition? pendingLayout;
    private bool showSettings;
    private string? error;
    // The leaderboard deal being replayed (from ?replay=<game id>), or null in normal play.
    private ReplayInfo? replay;
    private LayoutDefinition? replayLayout;
    // A guest win saved to the account after signing in, to tell the player about.
    private ClaimGameResponse? claimed;

    [SupplyParameterFromQuery(Name = "replay")]
    public Guid? ReplayId { get; set; }

    // The layout on the board: the replay's, or the player's own choice.
    private LayoutDefinition? PlayingLayout => replay != null ? replayLayout : currentLayout;

    private bool CanPlay => Session.State is SessionState.Playing or SessionState.NoMovesLeft;

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnSessionChanged;
        await Session.PreloadEffectsAsync();

        var auth = await AuthState.GetAuthenticationStateAsync();
        signedIn = auth.User.Identity?.IsAuthenticated == true;

        config = await Api.GetConfigAsync();
        layouts = config.ShowHiddenLayouts ? LayoutCatalog.All : LayoutCatalog.Visible;

        await Preferences.LoadAsync(signedIn);
        if (signedIn)
        {
            claimed = await GuestClaims.ClaimPendingAsync();
        }

        currentLayout = layouts.FirstOrDefault(l => l.Name == Preferences.LastLayout)
            ?? layouts.FirstOrDefault(l => l.Name == DefaultLayoutName)
            ?? layouts[0];

        if (ReplayId is { } replayId)
        {
            var info = await Api.GetReplayAsync(replayId);
            if (info != null && LayoutCatalog.Find(info.Layout) is { } layout)
            {
                replay = info;
                replayLayout = layout;
                await PlayReplayAsync();
                return;
            }

            error = "That deal couldn't be found, so here's a new game instead.";
        }

        await NewGameAsync();
    }

    private Task PlayAgainAsync() => replay != null ? PlayReplayAsync() : NewGameAsync();

    // Deals the replayed game's tiles. Signed-in players' replays are verified and ranked on the
    // deal's replay list; once the original drops off the leaderboard, replays are just for fun.
    private async Task PlayReplayAsync()
    {
        error = null;
        var mode = !replay!.CanPlay ? GameMode.Offline : signedIn ? GameMode.SignedIn : GameMode.Guest;
        try
        {
            await Session.StartAsync(replayLayout!, mode, replay);
        }
        catch (HttpRequestException e)
        {
            if (signedIn)
            {
                error = e.StatusCode == System.Net.HttpStatusCode.NotFound
                    ? "This deal is no longer on the leaderboard, so this replay won't be saved."
                    : "Couldn't reach the server, so this game won't be saved.";
            }

            await Session.StartAsync(replayLayout!, GameMode.Offline, replay);
        }

        if (signedIn && !replay!.CanPlay && error == null)
        {
            error = "This deal is no longer on the leaderboard, so this replay won't be saved.";
        }
    }

    // A game counts as under way once the first tile is clicked (that starts the clock).
    private bool GameUnderWay => Session.Game != null && Session.State != SessionState.Won && Session.ClockStarted;

    private async Task NewGameAsync()
    {
        if (replay != null)
        {
            // Leaving a replay: back to normal play, and drop ?replay= so a reload doesn't return to it.
            replay = null;
            replayLayout = null;
            Navigation.NavigateTo("", replace: true);
        }

        if (pendingLayout != null)
        {
            currentLayout = pendingLayout;
            pendingLayout = null;
        }

        error = null;
        try
        {
            await Session.StartAsync(currentLayout!, signedIn ? GameMode.SignedIn : GameMode.Guest);
        }
        catch (HttpRequestException)
        {
            // If the server can't start the game, still let them play (it just can't be saved).
            if (signedIn)
            {
                error = "Couldn't reach the server, so this game won't be saved.";
            }

            await Session.StartAsync(currentLayout!, GameMode.Offline);
        }
    }

    // Tiles and background change straight away; a new layout waits for the next game if one is under way.
    private async Task ApplySettingsAsync(SettingsChoice choice)
    {
        showSettings = false;

        if (choice.TileSetId != Preferences.TileSet.Id)
        {
            await Preferences.SetTileSetAsync(TileSets.Find(choice.TileSetId));
        }

        if (choice.BackgroundId != Preferences.Background.Id)
        {
            await Preferences.SetBackgroundAsync(Backgrounds.Find(choice.BackgroundId));
        }

        var layout = layouts.FirstOrDefault(l => l.Name == choice.LayoutName);
        if (layout is null || layout == (pendingLayout ?? currentLayout))
        {
            return;
        }

        await Preferences.SetLastLayoutAsync(layout.Name);
        if (layout == currentLayout)
        {
            pendingLayout = null;
        }
        else if (GameUnderWay || replay != null)
        {
            pendingLayout = layout;
        }
        else
        {
            pendingLayout = layout;
            await NewGameAsync();
        }
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
        Session.Dispose();
    }
}
