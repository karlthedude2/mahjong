@using Mahjong.Web.Client.Game

@* A horizontal, scrollable row of picture cards to choose from. A missing or broken picture shows a placeholder. *@
<div class="strip" role="group" aria-label="@Label">
    @foreach (var item in Items)
    {
        bool selected = item.Id == SelectedId;
        <button type="button" class="card @(selected ? "selected" : null)" aria-pressed="@(selected ? "true" : "false")"
                @key="item.Id" @ref="refs[item.Id]" @onclick="() => SelectAsync(item.Id)">
            <span class="picture">
                @if (failed.Contains(item.Id))
                {
                    <svg class="missing" viewBox="0 0 64 48" role="img" aria-label="No picture yet">
                        <rect x="6" y="6" width="52" height="36" rx="3" fill="none" stroke="currentColor" stroke-width="2.5" />
                        <circle cx="20" cy="18" r="4" fill="currentColor" />
                        <path d="M10 38 L24 26 L32 32 L42 22 L54 34" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" />
                        <line x1="4" y1="44" x2="60" y2="4" stroke="currentColor" stroke-width="3" />
                    </svg>
                }
                else
                {
                    <img src="@item.ImageUrl" alt="" loading="lazy" @onerror="() => failed.Add(item.Id)" />
                }
                @if (item.Badge != null)
                {
                    <span class="badge-label">@item.Badge</span>
                }
            </span>
            <span class="name">@item.Name</span>
        </button>
    }
</div>

@code {
    private readonly HashSet<string> failed = [];
    private readonly Dictionary<string, ElementReference> refs = [];

    [Parameter, EditorRequired] public IReadOnlyList<PreviewItem> Items { get; set; } = [];

    [Parameter] public string? SelectedId { get; set; }

    [Parameter] public EventCallback<string> SelectedIdChanged { get; set; }

    [Parameter] public string? Label { get; set; }

    /// <summary>Focuses the selected card, which also scrolls it into view.</summary>
    public async Task FocusSelectedAsync()
    {
        if (SelectedId != null && refs.TryGetValue(SelectedId, out var card))
        {
            await card.FocusAsync(preventScroll: false);
        }
    }

    private async Task SelectAsync(string id)
    {
        SelectedId = id;
        await SelectedIdChanged.InvokeAsync(id);
    }
}
