@using Mahjong.Web.Client.Api

@*
    A leaderboard deal's original score and its replay list (the heading is the caller's). Shared by
    the Replays page and the leaderboard dialog on the game page.
*@
<p class="replay-intro">
    @L.Html("Everyone who replays this deal gets exactly the same tiles. Replays are ranked here, one best score per player. The original was a first play, so it stays on the <a href=\"leaderboards?layout={0}\">{1} leaderboard</a> whatever happens below.", Uri.EscapeDataString(Info.Layout), L.LayoutName(Info.Layout))
</p>

<div class="original">
    <div class="original-text">
        <span class="overline">@L["Original score (first play)"]</span>
        <span class="original-score">@Info.OriginalScore.ToString("N0")</span>
        <span class="original-meta">
            @Info.OriginalPlayer
            @if (OriginalTime != "")
            {
                <text> &middot; @OriginalTime</text>
            }
            &middot; @Info.OriginalAchievedUtc.ToString("d MMM yyyy")
        </span>
    </div>
    @if (Info.CanPlay)
    {
        <a class="play-deal" href="?replay=@Info.OriginalGameId">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4l13 8-13 8z" /></svg>@L["Play this deal"]
        </a>
    }
</div>
@if (!Info.CanPlay)
{
    <p class="closed">@L["This deal has dropped off the leaderboard, so it's closed to new replays."]</p>
}

<h2 class="replay-heading">@L["Replay scores"]</h2>
@if (Info.Entries.Count == 0)
{
    <p class="replay-empty">@L["No replays yet. Be the first to try this deal."]</p>
}
else
{
    <LeaderboardTable Entries="Info.Entries" ShowDealLinks="false" BeatScore="Info.OriginalScore" />
}

@code {
    [Parameter, EditorRequired] public ReplayInfo Info { get; set; } = default!;

    private string OriginalTime => new LeaderboardEntry(0, "", 0, Info.OriginalSeconds, default).TimeText;
}
