@using Mahjong.Web.Client.Api

@*
    A leaderboard deal's original score and its replay list (the heading is the caller's). Shared by
    the Replays page and the leaderboard dialog on the game page.
*@
<p>
    @L.Html("Everyone who replays this deal gets exactly the same tiles. Replays are ranked here, one best score per player. The original was a first play, so it stays on the <a href=\"leaderboards?layout={0}\">{1} leaderboard</a> whatever happens below.", Uri.EscapeDataString(Info.Layout), L.LayoutName(Info.Layout))
</p>

<div class="original card mb-3">
    <div class="card-body">
        <div class="small text-uppercase text-muted">@L["Original score (first play)"]</div>
        <div class="d-flex flex-wrap align-items-baseline gap-3">
            <span class="fs-3 fw-bold">@Info.OriginalScore.ToString("N0")</span>
            <span>@Info.OriginalPlayer</span>
            @if (OriginalTime != "")
            {
                <span class="text-muted">@OriginalTime</span>
            }
            <span class="text-muted">@Info.OriginalAchievedUtc.ToString("d MMM yyyy")</span>
        </div>
    </div>
</div>

@if (Info.CanPlay)
{
    <p><a class="btn btn-primary" href="?replay=@Info.OriginalGameId">@L["Play this deal"]</a></p>
}
else
{
    <p class="text-muted">@L["This deal has dropped off the leaderboard, so it's closed to new replays."]</p>
}

<h2 class="h4">@L["Replay scores"]</h2>
@if (Info.Entries.Count == 0)
{
    <p>@L["No replays yet. Be the first to try this deal."]</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm">
            <thead>
                <tr><th scope="col">#</th><th scope="col">@L["Player"]</th><th scope="col" class="text-end">@L["Score"]</th><th scope="col" class="text-end" title="@L["How long the game took (pauses not counted)"]">@L["Time"]</th><th scope="col" class="text-end">@L["Date"]</th></tr>
            </thead>
            <tbody>
                @foreach (var entry in Info.Entries)
                {
                    <tr>
                        <td>@entry.Rank</td>
                        <td>
                            <AvatarImage Id="@entry.Avatar" Size="24" CssClass="me-1" />
                            @entry.DisplayName
                            @if (entry.Score > Info.OriginalScore)
                            {
                                <span class="badge bg-success ms-1">@L["Beat the original"]</span>
                            }
                        </td>
                        <td class="text-end">@entry.Score.ToString("N0")</td>
                        <td class="text-end">@entry.TimeText</td>
                        <td class="text-end">@entry.AchievedUtc.ToString("d MMM yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter, EditorRequired] public ReplayInfo Info { get; set; } = default!;

    private string OriginalTime => new LeaderboardEntry(0, "", 0, Info.OriginalSeconds, default).TimeText;
}
