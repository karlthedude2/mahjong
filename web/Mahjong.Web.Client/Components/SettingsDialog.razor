@using Mahjong.Core
@using Mahjong.Web.Client.Game

@* Layout, tile set and background in one place. Nothing changes until OK. *@
<div class="settings-backdrop" @onclick="CancelAsync">
    <div class="settings" role="dialog" aria-modal="true" aria-labelledby="settings-title"
         @onclick:stopPropagation="true" @onkeydown="OnKeyDownAsync">
        <header>
            <h2 id="settings-title">@L["Game settings"]</h2>
            <button type="button" class="btn-close" aria-label="@L["Close"]" @onclick="CancelAsync"></button>
        </header>

        <section>
            <h3>@L["Game"]</h3>
            <div class="segmented" role="radiogroup" aria-label="@L["Game"]">
                @foreach (var (option, name) in Tabs)
                {
                    <button type="button" role="radio" aria-checked="@(tab == option ? "true" : "false")"
                            class="@(tab == option ? "on" : null)" @onclick="() => tab = option">@L[name]</button>
                }
            </div>
            <p class="hint">
                @(tab switch
                {
                    GameTab.ThreeD => L["Mahjong Solitaire with stone tiles you can tilt and turn."],
                    GameTab.Cube => L["Take matching pairs from a cube you can turn. A tile can be taken when two of its sides that meet at an edge are open."],
                    GameTab.Connect => L["Remove matching pairs that can be joined by a line with at most two turns through empty space, even around the edge of the board."],
                    _ => L["Remove matching pairs of free tiles from the stack."],
                })
            </p>
        </section>

        @if (tab is GameTab.Solitaire or GameTab.ThreeD)
        {
            <section>
                <h3>@L["Layout"]</h3>
                <PreviewStrip @key="GameKind.Solitaire" @ref="layoutStrip" Label="@L["Layout"]" Items="layoutItems" @bind-SelectedId="layoutName" />
            </section>
        }
        else if (tab == GameTab.Cube)
        {
            <section>
                <h3>@L["Board size"]</h3>
                <div class="segmented" role="radiogroup" aria-label="@L["Board size"]">
                    @foreach (var (option, name) in CubeSizes)
                    {
                        <button type="button" role="radio" aria-checked="@(cubeSize == option ? "true" : "false")"
                                class="@(cubeSize == option ? "on" : null)" @onclick="() => cubeSize = option">@L[name] (@option×@option×@option)</button>
                    }
                </div>
            </section>
        }
        else
        {
            <section>
                <h3>@L["Board"]</h3>
                <PreviewStrip @key="GameKind.Connect" Label="@L["Board size"]" Items="boardItems" @bind-SelectedId="boardName" />
            </section>

            <section>
                <h3>@L["Gravity"]</h3>
                <div class="segmented" role="radiogroup" aria-label="@L["Gravity"]">
                    @foreach (var option in new[] { Gravity.None, Gravity.Down, Gravity.Left })
                    {
                        <button type="button" role="radio" aria-checked="@(gravity == option ? "true" : "false")"
                                class="@(gravity == option ? "on" : null)" @onclick="() => gravity = option">@(option switch { Gravity.Down => L["Down"], Gravity.Left => L["Left"], _ => L["Off"] })</button>
                    }
                </div>
                <p class="hint">
                    @(gravity switch
                    {
                        Gravity.Down => L["Tiles fall down to fill the gaps."],
                        Gravity.Left => L["Tiles slide left to fill the gaps."],
                        _ => L["Tiles stay where they are."],
                    })
                    @L["Each setting has its own leaderboard."]
                </p>
            </section>
        }

        <section>
            @if (tab is GameTab.ThreeD or GameTab.Cube)
            {
                <h3><label for="stone">@L["Stone"]</label></h3>
                <select id="stone" class="form-select" @bind="stoneId">
                    @foreach (var set in TileSets.Stones)
                    {
                        <option value="@set.Id">@L[set.Name]</option>
                    }
                </select>
            }
            else
            {
                <h3><label for="tile-set">@L["Tiles"]</label></h3>
                <select id="tile-set" class="form-select" @bind="flatId">
                    @foreach (var set in TileSets.Flat)
                    {
                        <option value="@set.Id">@L[set.Name]</option>
                    }
                </select>
            }
        </section>

        <section>
            <h3>@L["Deal"]</h3>
            <div class="deal-row">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" id="winnable" @bind="winnable" />
                    <label class="form-check-label" for="winnable">@L["Guaranteed winnable path"]</label>
                </div>
                @* Hover (or keyboard focus) shows the note; a tap toggles it, for touch screens. *@
                <span class="info @(showDealInfo ? "open" : null)">
                    <button type="button" class="info-button" aria-label="@L["About guaranteed winnable deals"]"
                            aria-expanded="@(showDealInfo ? "true" : "false")" @onclick="() => showDealInfo = !showDealInfo">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <circle cx="12" cy="12" r="9.5" />
                            <path d="M12 11v6M12 7.5v.01" />
                        </svg>
                    </button>
                    <span class="info-note" role="note">@L[WinnableNote]</span>
                </span>
            </div>
            <p class="hint">
                @(winnable ? L["Every deal can be cleared."] : L["Tiles are dealt at random, like a real set, so some deals can't be cleared."])
            </p>
        </section>

        <section>
            <h3>@L["Background"]</h3>
            <PreviewStrip Label="@L["Background"]" Items="backgroundItems" @bind-SelectedId="backgroundId" />
        </section>

        <section class="switch-row">
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="skip-settings" @bind="skipSettings" />
                <label class="form-check-label" for="skip-settings">@L["Don't show settings for every new game"]</label>
            </div>
            <p class="hint">@L["You can always change these with the settings gear in the header."]</p>
        </section>

        <footer>
            <button type="button" class="btn btn-light" @onclick="CancelAsync">@L["Cancel"]</button>
            <button type="button" class="btn btn-primary" @onclick="ApplyAsync">@(ForNewGame ? L["Start game"] : L["OK"])</button>
        </footer>
    </div>
</div>

@code {
    private PreviewStrip? layoutStrip;
    private IReadOnlyList<PreviewItem> layoutItems = [];
    private IReadOnlyList<PreviewItem> boardItems = [];
    /// <summary>
    /// The dialog's game tabs. Mahjong 3D is Mahjong Solitaire drawn in stone (it shares its layouts
    /// and leaderboards); which one is played follows the tile set chosen. Mahjong Cube is a game of
    /// its own with a size (Cube Small or Cube Large), its own leaderboards and the same stones.
    /// </summary>
    private enum GameTab { Solitaire, ThreeD, Cube, Connect }

    private static readonly (GameTab Tab, string Name)[] Tabs =
    [
        (GameTab.Solitaire, "Mahjong Solitaire"),
        (GameTab.ThreeD, "Mahjong 3D"),
        (GameTab.Cube, "Mahjong Cube"),
        (GameTab.Connect, "Connect (Shisen-Sho)"),
    ];

    private static readonly (int Size, string Name)[] CubeSizes = [(4, "Small"), (6, "Large")];

    private GameTab tab;
    private int cubeSize = 4;
    private string? boardName;
    private Gravity gravity;
    private IReadOnlyList<PreviewItem> backgroundItems = [];
    private string? layoutName;
    private string flatId = TileSets.Default.Id;
    private string stoneId = TileSets.DefaultStone.Id;
    private string backgroundId = Backgrounds.Default.Id;
    private bool skipSettings;
    private bool winnable = true;
    private bool showDealInfo;

    private const string WinnableNote = "As in life, a winnable game can still be lost if you choose the wrong path. Choose wisely.";

    [Parameter, EditorRequired] public IReadOnlyList<LayoutDefinition> Layouts { get; set; } = [];

    /// <summary>The layout of the game on the board, badged "Playing now".</summary>
    [Parameter] public string? PlayingLayoutName { get; set; }

    /// <summary>The layout to start selected: the one queued for the next game, if any.</summary>
    [Parameter] public string? LayoutName { get; set; }

    [Parameter] public string? TileSetId { get; set; }

    /// <summary>The last flat set and stone chosen, so switching tabs keeps each choice.</summary>
    [Parameter] public string? FlatTileSetId { get; set; }

    [Parameter] public string? StoneId { get; set; }

    [Parameter] public string? BackgroundId { get; set; }

    [Parameter] public bool SkipSettings { get; set; }

    [Parameter] public bool GuaranteedWinnable { get; set; } = true;

    /// <summary>True when the dialog opens before a new game is dealt (OK reads "Start game").</summary>
    [Parameter] public bool ForNewGame { get; set; }

    [Parameter] public EventCallback<SettingsChoice> OnApply { get; set; }

    [Parameter] public EventCallback OnCancel { get; set; }

    protected override void OnInitialized()
    {
        var playing = PlayingLayoutName == null ? null : LayoutCatalog.Find(PlayingLayoutName);
        layoutItems = Layouts
            .Select(l => new PreviewItem(l.Name, L.LayoutName(l), LayoutPreviews.Url(l.PreviewName), l.Name == PlayingLayoutName ? L["Playing now"] : null))
            .ToList();
        boardItems = ConnectLayouts.BaseBoards
            .Select(b => new PreviewItem(b.Name, $"{L[b.Name[(ConnectLayouts.Prefix.Length + 1)..]]} ({b.Columns}×{b.Rows})", LayoutPreviews.Url(b.PreviewName),
                playing?.PreviewName == b.PreviewName ? L["Playing now"] : null))
            .ToList();

        // Start from the chosen (or playing) layout: its game, and for Connect its board and gravity.
        var chosen = LayoutCatalog.Find(LayoutName ?? PlayingLayoutName ?? "");
        var tileSet = TileSets.Find(TileSetId);
        tab = chosen?.Kind == GameKind.Cube ? GameTab.Cube
            : chosen?.Kind == GameKind.Connect ? GameTab.Connect
            : tileSet.Kind == TileSetKind.ThreeD ? GameTab.ThreeD
            : GameTab.Solitaire;
        cubeSize = chosen?.Kind == GameKind.Cube ? chosen.Size : 4;
        boardName = chosen?.Kind == GameKind.Connect ? chosen.PreviewName : ConnectLayouts.BaseBoards[0].Name;
        gravity = chosen?.Kind == GameKind.Connect ? chosen.Gravity : Gravity.None;
        backgroundItems = Backgrounds.All.Select(b => new PreviewItem(b.Id, L[b.Name], b.Url)).ToList();

        layoutName = chosen?.Kind == GameKind.Solitaire ? chosen.Name : Layouts.FirstOrDefault()?.Name;
        flatId = TileSets.Flat.FirstOrDefault(s => s.Id == FlatTileSetId)?.Id ?? TileSets.Default.Id;
        stoneId = TileSets.Stones.FirstOrDefault(s => s.Id == StoneId)?.Id ?? TileSets.DefaultStone.Id;
        backgroundId = Backgrounds.Find(BackgroundId).Id;
        skipSettings = SkipSettings;
        winnable = GuaranteedWinnable;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && layoutStrip != null)
        {
            await layoutStrip.FocusSelectedAsync();
        }
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await CancelAsync();
        }
    }

    private Task CancelAsync() => OnCancel.InvokeAsync();

    private Task ApplyAsync()
    {
        string chosen = tab == GameTab.Connect
            ? ConnectLayouts.WithGravity(LayoutCatalog.Find(boardName!)!, gravity).Name
            : layoutName ?? PlayingLayoutName ?? "";
        if (tab == GameTab.Cube)
        {
            // The block of the chosen size, in the chosen stone; the other games' tile set stays as it is.
            return OnApply.InvokeAsync(new SettingsChoice(CubeLayouts.ForSize(cubeSize).Name, TileSets.Find(TileSetId).Id, backgroundId, skipSettings, winnable,
                StoneId: stoneId));
        }

        string tileSetId = tab == GameTab.ThreeD ? stoneId : flatId;
        return OnApply.InvokeAsync(new SettingsChoice(chosen, tileSetId, backgroundId, skipSettings, winnable));
    }
}
