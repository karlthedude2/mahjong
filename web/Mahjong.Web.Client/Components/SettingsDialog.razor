@using Mahjong.Core
@using Mahjong.Web.Client.Game

@* Layout, tile set and background in one place. Nothing changes until OK. *@
<div class="settings-backdrop" @onclick="CancelAsync">
    <div class="settings" role="dialog" aria-modal="true" aria-labelledby="settings-title"
         @onclick:stopPropagation="true" @onkeydown="OnKeyDownAsync">
        <header>
            <h2 id="settings-title">Game settings</h2>
            <button type="button" class="btn-close" aria-label="Close" @onclick="CancelAsync"></button>
        </header>

        <section>
            <h3>Game</h3>
            <div class="segmented" role="radiogroup" aria-label="Game">
                <button type="button" role="radio" aria-checked="@(game == GameKind.Solitaire ? "true" : "false")"
                        class="@(game == GameKind.Solitaire ? "on" : null)" @onclick="() => game = GameKind.Solitaire">Mahjong Solitaire</button>
                <button type="button" role="radio" aria-checked="@(game == GameKind.Connect ? "true" : "false")"
                        class="@(game == GameKind.Connect ? "on" : null)" @onclick="() => game = GameKind.Connect">Connect (Shisen-Sho)</button>
            </div>
            <p class="hint">
                @(game == GameKind.Solitaire
                    ? "Remove matching pairs of free tiles from the stack."
                    : "Remove matching pairs that can be joined by a line with at most two turns through empty space, even around the edge of the board.")
            </p>
        </section>

        @if (game == GameKind.Solitaire)
        {
            <section>
                <h3>Layout</h3>
                <PreviewStrip @key="GameKind.Solitaire" @ref="layoutStrip" Label="Layout" Items="layoutItems" @bind-SelectedId="layoutName" />
            </section>
        }
        else
        {
            <section>
                <h3>Board</h3>
                <PreviewStrip @key="GameKind.Connect" Label="Board size" Items="boardItems" @bind-SelectedId="boardName" />
            </section>

            <section>
                <h3>Gravity</h3>
                <div class="segmented" role="radiogroup" aria-label="Gravity">
                    @foreach (var option in new[] { Gravity.None, Gravity.Down, Gravity.Left })
                    {
                        <button type="button" role="radio" aria-checked="@(gravity == option ? "true" : "false")"
                                class="@(gravity == option ? "on" : null)" @onclick="() => gravity = option">@(option == Gravity.None ? "Off" : option.ToString())</button>
                    }
                </div>
                <p class="hint">
                    @(gravity switch
                    {
                        Gravity.Down => "Tiles fall down to fill the gaps.",
                        Gravity.Left => "Tiles slide left to fill the gaps.",
                        _ => "Tiles stay where they are.",
                    })
                    Each setting has its own leaderboard.
                </p>
            </section>
        }

        <section>
            <h3><label for="tile-set">Tiles</label></h3>
            <select id="tile-set" class="form-select" @bind="tileSetId">
                @foreach (var set in TileSets.All)
                {
                    <option value="@set.Id">@set.Name</option>
                }
            </select>
        </section>

        <section>
            <h3>Deal</h3>
            <div class="deal-row">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" id="winnable" @bind="winnable" />
                    <label class="form-check-label" for="winnable">Guaranteed winnable path</label>
                </div>
                @* Hover (or keyboard focus) shows the note; a tap toggles it, for touch screens. *@
                <span class="info @(showDealInfo ? "open" : null)">
                    <button type="button" class="info-button" aria-label="About guaranteed winnable deals"
                            aria-expanded="@(showDealInfo ? "true" : "false")" @onclick="() => showDealInfo = !showDealInfo">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <circle cx="12" cy="12" r="9.5" />
                            <path d="M12 11v6M12 7.5v.01" />
                        </svg>
                    </button>
                    <span class="info-note" role="note">@WinnableNote</span>
                </span>
            </div>
            <p class="hint">
                @(winnable ? "Every deal can be cleared." : "Tiles are dealt at random, like a real set, so some deals can't be cleared.")
            </p>
        </section>

        <section>
            <h3>Background</h3>
            <PreviewStrip Label="Background" Items="backgroundItems" @bind-SelectedId="backgroundId" />
        </section>

        <section class="switch-row">
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="skip-settings" @bind="skipSettings" />
                <label class="form-check-label" for="skip-settings">Don't show settings for every new game</label>
            </div>
            <p class="hint">You can always change these with the settings gear in the header.</p>
        </section>

        <footer>
            <button type="button" class="btn btn-light" @onclick="CancelAsync">Cancel</button>
            <button type="button" class="btn btn-primary" @onclick="ApplyAsync">@(ForNewGame ? "Start game" : "OK")</button>
        </footer>
    </div>
</div>

@code {
    private PreviewStrip? layoutStrip;
    private IReadOnlyList<PreviewItem> layoutItems = [];
    private IReadOnlyList<PreviewItem> boardItems = [];
    private GameKind game;
    private string? boardName;
    private Gravity gravity;
    private IReadOnlyList<PreviewItem> backgroundItems = [];
    private string? layoutName;
    private string tileSetId = TileSets.Default.Id;
    private string backgroundId = Backgrounds.Default.Id;
    private bool skipSettings;
    private bool winnable = true;
    private bool showDealInfo;

    private const string WinnableNote = "As in life, a winnable game can still be lost if you choose the wrong path. Choose wisely.";

    [Parameter, EditorRequired] public IReadOnlyList<LayoutDefinition> Layouts { get; set; } = [];

    /// <summary>The layout of the game on the board, badged "Playing now".</summary>
    [Parameter] public string? PlayingLayoutName { get; set; }

    /// <summary>The layout to start selected: the one queued for the next game, if any.</summary>
    [Parameter] public string? LayoutName { get; set; }

    [Parameter] public string? TileSetId { get; set; }

    [Parameter] public string? BackgroundId { get; set; }

    [Parameter] public bool SkipSettings { get; set; }

    [Parameter] public bool GuaranteedWinnable { get; set; } = true;

    /// <summary>True when the dialog opens before a new game is dealt (OK reads "Start game").</summary>
    [Parameter] public bool ForNewGame { get; set; }

    [Parameter] public EventCallback<SettingsChoice> OnApply { get; set; }

    [Parameter] public EventCallback OnCancel { get; set; }

    protected override void OnInitialized()
    {
        var playing = PlayingLayoutName == null ? null : LayoutCatalog.Find(PlayingLayoutName);
        layoutItems = Layouts
            .Select(l => new PreviewItem(l.Name, l.Name, LayoutPreviews.Url(l.PreviewName), l.Name == PlayingLayoutName ? "Playing now" : null))
            .ToList();
        boardItems = ConnectLayouts.BaseBoards
            .Select(b => new PreviewItem(b.Name, $"{b.Name[(ConnectLayouts.Prefix.Length + 1)..]} ({b.Columns}×{b.Rows})", LayoutPreviews.Url(b.PreviewName),
                playing?.PreviewName == b.PreviewName ? "Playing now" : null))
            .ToList();

        // Start from the chosen (or playing) layout: its game, and for Connect its board and gravity.
        var chosen = LayoutCatalog.Find(LayoutName ?? PlayingLayoutName ?? "");
        game = chosen?.Kind ?? GameKind.Solitaire;
        boardName = chosen?.Kind == GameKind.Connect ? chosen.PreviewName : ConnectLayouts.BaseBoards[0].Name;
        gravity = chosen?.Kind == GameKind.Connect ? chosen.Gravity : Gravity.None;
        backgroundItems = Backgrounds.All.Select(b => new PreviewItem(b.Id, b.Name, b.Url)).ToList();

        layoutName = chosen?.Kind == GameKind.Solitaire ? chosen.Name : Layouts.FirstOrDefault()?.Name;
        tileSetId = TileSets.Find(TileSetId).Id;
        backgroundId = Backgrounds.Find(BackgroundId).Id;
        skipSettings = SkipSettings;
        winnable = GuaranteedWinnable;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && layoutStrip != null)
        {
            await layoutStrip.FocusSelectedAsync();
        }
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await CancelAsync();
        }
    }

    private Task CancelAsync() => OnCancel.InvokeAsync();

    private Task ApplyAsync()
    {
        string chosen = game == GameKind.Connect
            ? ConnectLayouts.WithGravity(LayoutCatalog.Find(boardName!)!, gravity).Name
            : layoutName ?? PlayingLayoutName ?? "";
        return OnApply.InvokeAsync(new SettingsChoice(chosen, tileSetId, backgroundId, skipSettings, winnable));
    }
}
