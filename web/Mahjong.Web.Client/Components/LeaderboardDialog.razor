@using Mahjong.Core
@using Mahjong.Web.Client.Api
@inject GameApi Api

@*
    The leaderboards over the paused game, with everything the Leaderboards page has: the games'
    tabs, the layout picker, and each score's links to its deal and replay list. A replay list
    opens here too, with a way back. The page decides what's shown (LayoutName, ReplayId): the
    links in here are caught by the game page and come back to it as changes to those.
*@
<div class="board-backdrop" @onclick="CloseAsync">
    <div class="board-dialog" role="dialog" aria-modal="true" aria-labelledby="leaderboard-title"
         @onclick:stopPropagation="true" @onkeydown="OnKeyDownAsync" tabindex="-1" @ref="dialog">
        <header>
            @if (ReplayId != null)
            {
                <button type="button" class="back" @onclick="() => OnShowLeaderboard.InvokeAsync(LayoutName)">
                    &larr; @L["Back to leaderboards"]
                </button>
            }
            <h2 id="leaderboard-title">
                @if (ReplayId == null)
                {
                    @L["Leaderboards"]
                }
                else if (replay != null)
                {
                    @L["{0}'s {1} deal", replay.OriginalPlayer, L.LayoutName(replay.Layout)]
                    @if (replay.RandomDeal)
                    {
                        <span class="title-tag">@L["Random deal"]</span>
                    }
                }
                else
                {
                    @L["Replays"]
                }
            </h2>
            @if (ReplayId == null)
            {
                <LeaderboardIntro />
            }
            <button type="button" class="btn-close btn-close-white" aria-label="@L["Close"]" @onclick="CloseAsync"></button>
        </header>

        @* Keyed to what's shown, so moving between the leaderboard and a replay list starts at the top. *@
        <div class="body" @key="(LayoutName, ReplayId)">
            @if (ReplayId != null)
            {
                @if (replay != null)
                {
                    <ReplayDetails Info="replay" />
                }
                else
                {
                    <p class="status">@(failed ? L["This deal couldn't be found. It may never have been on a leaderboard."] : L["Loading…"])</p>
                }
            }
            else
            {
                <div class="board-controls">
                    <div class="seg" role="group" aria-label="@L["Game"]">
                        @foreach (var kind in Kinds)
                        {
                            <button type="button" class="@(kind == Kind ? "active" : null)" aria-pressed="@(kind == Kind ? "true" : "false")" @onclick="() => ShowKindAsync(kind)"><span class="short">@KindShortName(kind)</span><span class="long">@KindName(kind)</span></button>
                        }
                    </div>

                    <label class="select-field">
                        <span>@PickerLabel</span>
                        <select value="@LayoutName" @onchange="OnLayoutChangedAsync">
                            @foreach (var l in Layouts.Where(l => l.Kind == Kind))
                            {
                                <option value="@l.Name">@L.LayoutName(l)</option>
                            }
                        </select>
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
                    </label>
                </div>

                @if (entries == null)
                {
                    <p class="status">@(failed ? L["The leaderboard couldn't be loaded. Check your connection and try again."] : L["Loading…"])</p>
                }
                else if (entries.Count == 0)
                {
                    <p class="status">@L["No scores on {0} yet. Be the first!", L.LayoutName(LayoutName)]</p>
                }
                else
                {
                    <LeaderboardTable Entries="entries" />
                }
            }
        </div>
    </div>
</div>

@code {
    private const string DefaultLayoutName = "Twin Peaks";
    private static readonly GameKind[] Kinds = [GameKind.Solitaire, GameKind.Connect, GameKind.Cube];

    private ElementReference dialog;
    private IReadOnlyList<LeaderboardEntry>? entries;
    private ReplayInfo? replay;
    private bool failed;
    private (string, Guid?)? shown;

    /// <summary>The layouts to choose from: solitaire, Connect and the cubes.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<LayoutDefinition> Layouts { get; set; } = [];

    /// <summary>The leaderboard shown (or gone back to from a replay list).</summary>
    [Parameter, EditorRequired] public string LayoutName { get; set; } = "";

    /// <summary>The leaderboard game whose replay list is shown, or null for the leaderboard.</summary>
    [Parameter] public Guid? ReplayId { get; set; }

    /// <summary>Asks for another leaderboard: a tab, the picker, or Back from a replay list.</summary>
    [Parameter] public EventCallback<string> OnShowLeaderboard { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    private GameKind Kind => Layouts.FirstOrDefault(l => l.Name == LayoutName)?.Kind ?? GameKind.Solitaire;

    private string PickerLabel => Kind switch
    {
        GameKind.Connect => L["Board"],
        GameKind.Cube => L["Board size"],
        _ => L["Layout"],
    };

    protected override async Task OnParametersSetAsync()
    {
        if (shown == (LayoutName, ReplayId))
        {
            return;
        }

        shown = (LayoutName, ReplayId);
        failed = false;
        if (ReplayId is { } id)
        {
            replay = null;
            replay = await Api.GetReplayAsync(id);
            failed = replay == null;
        }
        else
        {
            entries = null;
            entries = await Api.GetLeaderboardAsync(LayoutName);
            failed = entries == null;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // So Escape works straight away.
            await dialog.FocusAsync();
        }
    }

    private string KindName(GameKind kind) => kind switch
    {
        GameKind.Connect => L["Connect (Shisen-Sho)"],
        GameKind.Cube => L["Mahjong Cube"],
        _ => L["Mahjong Solitaire"],
    };

    private string KindShortName(GameKind kind) => kind switch
    {
        GameKind.Connect => L["Connect"],
        GameKind.Cube => L["Cube"],
        _ => L["Solitaire"],
    };

    // A game's tab opens on its first board (Twin Peaks for solitaire, as on the Leaderboards page).
    private Task ShowKindAsync(GameKind kind)
    {
        var choices = Layouts.Where(l => l.Kind == kind).ToList();
        var first = choices.FirstOrDefault(l => l.Name == DefaultLayoutName) ?? choices.FirstOrDefault();
        return kind == Kind || first == null ? Task.CompletedTask : OnShowLeaderboard.InvokeAsync(first.Name);
    }

    private Task OnLayoutChangedAsync(ChangeEventArgs e) => OnShowLeaderboard.InvokeAsync((string?)e.Value ?? LayoutName);

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await CloseAsync();
        }
    }

    private Task CloseAsync() => OnClose.InvokeAsync();
}
