@using Mahjong.Core
@using Mahjong.Web.Client.Api
@implements IDisposable

@{
    // Ranked games show the server's verified breakdown; guests see the local one.
    var breakdown = Session.Result?.Breakdown ?? BreakdownDto.From(Session.Game!.Scoring.Card.Breakdown);
}

<div class="results-backdrop" role="dialog" aria-modal="true" aria-labelledby="results-title">
    <div class="results">
        <h2 id="results-title">@L["You cleared {0}!", LayoutName]</h2>

        <table class="breakdown">
            <tbody>
                <tr title="@L["Face value of every tile you removed."]">
                    <th>@L["Tile Points Completed"]</th><td>@breakdown.TilePoints.ToString("N0")</td>
                </tr>
                <tr title="@L["20 tiles inside one 30-second window: 100 points per second left."]">
                    <th>@L["Speed Bonus"] <span class="count">(@breakdown.SpeedBonusCount &times;)</span></th><td>@breakdown.SpeedBonusTotal.ToString("N0")</td>
                </tr>
                <tr title="@L["Every 20 tiles: the seconds left on the 5-minute bonus clock."]">
                    <th>@L["Pace Bonus"]</th><td>@breakdown.PaceBonusTotal.ToString("N0")</td>
                </tr>
                <tr title="@L["30 points per second left on the bonus clock when you finished."]">
                    <th>@L["Time Left Bonus"]</th><td>@breakdown.TimeBonus.ToString("N0")</td>
                </tr>
                <tr title="@L["5,000 for a fast finish, dropping in steps after 2:40."]">
                    <th>@L["Quick Finish Bonus"]</th><td>@breakdown.QuickFinishBonus.ToString("N0")</td>
                </tr>
                <tr title="@L["3,000, less 1,000 for each shuffle and 500 for each hint."]">
                    <th>@L["No-Shuffle Bonus"]</th><td>@breakdown.NoShuffleBonus.ToString("N0")</td>
                </tr>
            </tbody>
            <tfoot>
                <tr><th>@L["Total"]</th><td>@breakdown.Total.ToString("N0")</td></tr>
            </tfoot>
        </table>

        @if (Session.Replay is { } replay)
        {
            <p class="replay-compare">
                @if (breakdown.Total > replay.OriginalScore)
                {
                    <span>@L.Html("You beat <strong>{0}</strong>'s original score of {1}!", replay.OriginalPlayer, replay.OriginalScore.ToString("N0"))</span>
                }
                else
                {
                    <span>@L.Html("<strong>{0}</strong>'s original score was {1}.", replay.OriginalPlayer, replay.OriginalScore.ToString("N0"))</span>
                }
            </p>
        }

        @if (Session.IsRanked)
        {
            <p class="verdict">
                @if (Session.SubmittingResult)
                {
                    <span>@L["Checking your game…"]</span>
                }
                else if (Session.Replay != null && Session.Result is { ReplayRank: { } replayRank })
                {
                    <span>@L.Html("Verified. You're <strong>#{0}</strong> on this deal's <a href=\"replays/{1}\">replay list</a>!", replayRank, Session.Replay.OriginalGameId)</span>
                }
                else if (Session.Replay != null && Session.Result != null)
                {
                    <span>@L.Html("Verified. Not a new best for you on this deal's <a href=\"replays/{0}\">replay list</a>.", Session.Replay.OriginalGameId)</span>
                }
                else if (Session.Result is { Rank: { } rank })
                {
                    <span>@L.Html("Verified. You're <strong>#{0}</strong> on the {1} leaderboard!", rank, LayoutName)</span>
                }
                else if (Session.Result != null)
                {
                    <span>@L["Verified. Not in the top 20 this time."]</span>
                }
                else
                {
                    <span class="error">@L["We couldn't verify this game, so it wasn't saved."]</span>
                }
            </p>
        }
        else
        {
            @if (Session.IsPractice)
            {
                <p class="verdict">@L["That was practice, so it isn't saved or ranked. Start a new game to play for the leaderboard."]</p>
            }
            else if (Session.IsGuestVerified && Session.Result is { Won: true })
            {
                <p class="verdict">
                    @(Session.Replay != null
                        ? L.Html("<strong>Save this score:</strong> <a href=\"Account/Login\">sign in</a> or <a href=\"Account/Register\">create an account</a> within a day, on this device, and it goes on this deal's replay list as if you'd been signed in.")
                        : L.Html("<strong>Save this score:</strong> <a href=\"Account/Login\">sign in</a> or <a href=\"Account/Register\">create an account</a> within a day, on this device, and it goes on the leaderboard as if you'd been signed in."))
                </p>
            }
            else if (Session.IsGuestVerified && Session.SubmittingResult)
            {
                <p class="verdict">@L["Checking your game…"]</p>
            }
            else
            {
                <p class="verdict">@L.Html("<a href=\"Account/Login\">Sign in</a> to save your scores, get on the leaderboards and see fewer ads.")</p>
            }
            <AdSlot ClientId="@Config?.AdsClientId" SlotId="@Config?.AdSlotResults" Format="rectangle" CssClass="results-ad" />
        }

        <div class="actions">
            <button class="btn btn-primary" disabled="@(countdown > 0)" @onclick="OnPlayAgain">
                @(PlayAgainText + (countdown > 0 ? $" ({countdown})" : ""))
            </button>
        </div>
    </div>
</div>

@code {
    private int countdown;
    private Timer? timer;

    [Parameter, EditorRequired] public Game.GameSession Session { get; set; } = default!;

    private string PlayAgainText => Session.Replay != null || Session.IsPractice ? L["Try this deal again"] : L["Play again"];

    [Parameter] public ClientConfig? Config { get; set; }

    [Parameter] public string LayoutName { get; set; } = "";

    [Parameter] public EventCallback OnPlayAgain { get; set; }

    protected override void OnInitialized()
    {
        // Guests see the results ad for a few seconds before they can start the next game.
        if (!Session.IsRanked)
        {
            countdown = 5;
            timer = new Timer(_ => InvokeAsync(() =>
            {
                if (--countdown <= 0)
                {
                    timer?.Dispose();
                }

                StateHasChanged();
            }), null, 1000, 1000);
        }
    }

    public void Dispose() => timer?.Dispose();
}
