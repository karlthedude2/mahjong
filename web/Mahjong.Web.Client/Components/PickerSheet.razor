@using Mahjong.Web.Client.Game

@* A sheet of pictures that slides up over the settings screen. A tap picks and closes; ×, Escape or the dimmed area closes without picking. *@
<div class="sheet-backdrop" @onclick="CloseAsync">
    <section class="sheet" role="dialog" aria-modal="true" aria-labelledby="@titleId"
             @onclick:stopPropagation="true" @onkeydown="OnKeyDownAsync" @onkeydown:stopPropagation="true">
        <span class="handle" aria-hidden="true"></span>
        <header>
            <h2 id="@titleId">@Title</h2>
            <button type="button" class="close" aria-label="@L["Close"]" @onclick="CloseAsync">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
            </button>
        </header>
        <div class="grid" role="group" aria-label="@Title">
            @foreach (var item in Items)
            {
                bool selected = item.Id == SelectedId;
                <button type="button" class="item @(selected ? "selected" : null)" aria-pressed="@(selected ? "true" : "false")"
                        @key="item.Id" @ref="refs[item.Id]" @onclick="() => OnPick.InvokeAsync(item.Id)">
                    <span class="picture">
                        @if (BackdropUrl != null)
                        {
                            <img class="backdrop" src="@BackdropUrl" alt="" loading="lazy" />
                        }
                        @if (failed.Contains(item.Id))
                        {
                            <svg class="missing" viewBox="0 0 64 48" role="img" aria-label="@L["No picture yet"]">
                                <rect x="6" y="6" width="52" height="36" rx="3" fill="none" stroke="currentColor" stroke-width="2.5" />
                                <circle cx="20" cy="18" r="4" fill="currentColor" />
                                <path d="M10 38 L24 26 L32 32 L42 22 L54 34" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" />
                                <line x1="4" y1="44" x2="60" y2="4" stroke="currentColor" stroke-width="3" />
                            </svg>
                        }
                        else
                        {
                            <img class="@(BackdropUrl != null ? "over" : "full")" src="@item.ImageUrl" alt="" loading="lazy" @onerror="() => failed.Add(item.Id)" />
                        }
                        @if (selected)
                        {
                            <span class="check" aria-hidden="true">
                                <svg viewBox="0 0 24 24"><path d="M5 12l5 5 9-10" /></svg>
                            </span>
                        }
                        @if (item.Badge != null)
                        {
                            <span class="badge-label">@item.Badge</span>
                        }
                    </span>
                    <span class="name">@item.Name</span>
                </button>
            }
        </div>
    </section>
</div>

@code {
    private readonly HashSet<string> failed = [];
    private readonly Dictionary<string, ElementReference> refs = [];
    private readonly string titleId = $"sheet-{Guid.NewGuid():N}";

    [Parameter, EditorRequired] public string Title { get; set; } = "";

    [Parameter, EditorRequired] public IReadOnlyList<PreviewItem> Items { get; set; } = [];

    [Parameter] public string? SelectedId { get; set; }

    /// <summary>A background drawn behind each picture (for layouts and boards, whose pictures are see-through).</summary>
    [Parameter] public string? BackdropUrl { get; set; }

    [Parameter] public EventCallback<string> OnPick { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Start on the current choice, which also scrolls it into view.
        if (firstRender && SelectedId != null && refs.TryGetValue(SelectedId, out var item))
        {
            await item.FocusAsync(preventScroll: false);
        }
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await CloseAsync();
        }
    }

    private Task CloseAsync() => OnClose.InvokeAsync();
}
