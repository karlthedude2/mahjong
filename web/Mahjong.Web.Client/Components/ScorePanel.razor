@using Mahjong.Core

@{
    var card = Game.Scoring.Card;
    var clock = Game.Scoring.Clock;
    int tilesToPace = Scoring.TilesPerBonus - card.TilesTowardPaceBonus;
    bool finishBonusesLive = Game.Scoring.EarnsFinalBonus;
}

<section class="score-panel" aria-label="@L["Score"]">
    <div class="headline">
        <div class="stat">
            <span class="label">@L["Score"]</span>
            <span class="value">@card.Score.ToString("N0")</span>
        </div>
        <div class="stat">
            <span class="label">@L["Time"]</span>
            <span class="value">@clock.ClockText</span>
            @if (!ClockStarted)
            {
                <span class="hint">@L["Starts on your first move"]</span>
            }
        </div>
    </div>

    <div class="bonus" title="@L["Remove 20 tiles inside one 30-second window to earn 100 points for every second still left in it."]">
        <div class="bonus-name">@L["Speed Bonus"]</div>
        <div class="meter" role="progressbar" aria-valuemin="0" aria-valuemax="20" aria-valuenow="@card.SpeedWindowTiles">
            <div class="meter-fill" style="width: @(card.SpeedWindowTiles * 100 / Scoring.TilesPerBonus)%"></div>
        </div>
        <div class="bonus-detail">
            @L["{0} of 20 tiles · {1} s left · worth {2} now", card.SpeedWindowTiles, clock.SpeedWindowSeconds, (Scoring.SpeedBonusPerSecond * clock.SpeedWindowSeconds).ToString("N0")]
        </div>
        <div class="bonus-earned">@L["Earned: {0} × = {1}", card.SpeedBonusCount, card.SpeedBonusTotal.ToString("N0")]</div>
    </div>

    <div class="bonus" title="@L["Every 20 tiles you remove adds the seconds left on the 5-minute bonus clock."]">
        <div class="bonus-name">@L["Pace Bonus"]</div>
        <div class="bonus-detail">
            @(tilesToPace == 1 ? L["Next in 1 tile, worth {0}", clock.BonusClockSeconds] : L["Next in {0} tiles, worth {1}", tilesToPace, clock.BonusClockSeconds])
        </div>
        <div class="bonus-earned">@L["Earned: {0}", card.PaceBonusTotal.ToString("N0")]</div>
    </div>

    <div class="bonus @(finishBonusesLive ? null : "expired")" title="@L["Paid when you clear the board, but only if you finish before the 5-minute bonus clock runs out."]">
        <div class="bonus-name">
            @L["Finish Bonuses"]
            <span class="bonus-clock">@(finishBonusesLive ? L["{0} left", $"{clock.BonusClockSeconds / 60}:{clock.BonusClockSeconds % 60:00}"] : L["clock ran out"])</span>
        </div>
        @if (finishBonusesLive)
        {
            <ul class="finish-list">
                <li title="@L["30 points for every second left on the bonus clock."]"><span>@L["Time Left"]</span><span>@Game.Scoring.TimeBonusNow.ToString("N0")</span></li>
                <li title="@L["Starts at 5,000 and drops in steps after 2:40."]"><span>@L["Quick Finish"]</span><span>@clock.QuickFinishBonus.ToString("N0")</span></li>
                <li title="@L["Starts at 3,000; each shuffle costs 1,000 and each hint 500."]"><span>@L["No Shuffle"]</span><span>@Game.Scoring.NoShuffleBonusNow.ToString("N0")</span></li>
            </ul>
        }
        else
        {
            <div class="bonus-detail">@L["Finish bonuses are only paid for games under 5 minutes."]</div>
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired] public MahjongGame Game { get; set; } = default!;

    [Parameter] public bool ClockStarted { get; set; } = true;
}
